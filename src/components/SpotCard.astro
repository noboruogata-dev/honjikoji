---
import Badge from './Badge.astro';
import GenreIcon from './GenreIcon.astro';
import OpenStatus from './OpenStatus.astro';
import { Play } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  spot: CollectionEntry<'spots'>;
  /** 一覧内での並び順。指定するとスクロールで時間差をつけて浮かび上がる
   *  （global.cssの[data-reveal]参照）。/spots/のようにJSでカードの
   *  表示・非表示を切り替えるフィルタ付き一覧では指定しないこと
   *  （display:noneの間はIntersectionObserverが交差判定できず、
   *  フィルタで後から表示された時に不透明度0のまま固まる恐れがあるため）。 */
  revealIndex?: number;
}

const { spot, revealIndex } = Astro.props;
const {
  title,
  genre,
  budget,
  budgetMin,
  budgetMax,
  openHours,
  regularHoliday,
  vibes,
  isNew,
  hours,
  isIrregular,
  description,
  youtubeVideos,
} = spot.data;
const hasVideo = (youtubeVideos?.length ?? 0) > 0;
---

<a
  href={`/spots/${spot.id}/`}
  data-spot-card
  data-genre={genre}
  data-vibes={vibes.join('|')}
  data-hours={JSON.stringify(hours ?? null)}
  data-budget-min={budgetMin ?? ''}
  data-budget-max={budgetMax ?? ''}
  data-has-video={hasVideo ? '1' : ''}
  data-reveal={revealIndex !== undefined ? true : undefined}
  style={revealIndex !== undefined ? `--reveal-i:${revealIndex}` : undefined}
  class="group relative flex flex-col overflow-hidden rounded-xl border border-night-700 bg-night-900/80 shadow-lg shadow-black/30 transition duration-300 hover:-translate-y-0.5 hover:border-amber-deep/70 hover:shadow-amber-deep/10"
>
  {
    isNew && (
      <span class="absolute right-3 top-3 z-10 inline-flex items-center gap-1 rounded-full bg-vermilion px-2.5 py-1 text-[0.65rem] font-bold tracking-wide text-white shadow-lg shadow-vermilion/40">
        <span class="lantern-breathe h-1.5 w-1.5 rounded-full bg-white" />
        NEW
      </span>
    )
  }
  <div class="flex items-center justify-between gap-2 border-b border-night-700 bg-night-800/50 px-4 py-3">
    <span class="inline-flex items-center gap-1.5 text-xs font-medium tracking-wide text-amber-glow">
      <GenreIcon genre={genre} size={14} />
      {genre}
    </span>
    {
      hasVideo && (
        <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-vermilion/15 px-2 py-0.5 text-[0.65rem] font-semibold text-vermilion">
          <Play size={10} class="fill-vermilion" aria-hidden="true" />
          動画あり
        </span>
      )
    }
  </div>
  <div class="flex flex-1 flex-col gap-3 px-4 py-4">
    <h3
      class="font-serif text-xl font-bold text-gold-100 transition group-hover:text-amber-glow"
    >
      {title}
    </h3>
    <p class="line-clamp-2 text-sm leading-relaxed text-gold-100/60">
      {description}
    </p>
    <dl class="mt-1 space-y-1 text-xs text-gold-100/50">
      <div class="flex items-center gap-2">
        <dt class="shrink-0 text-gold-100/55">営業時間</dt>
        <dd class="min-w-0 flex-1 truncate">{openHours}</dd>
        <OpenStatus hours={hours} isIrregular={isIrregular} size="sm" />
      </div>
      <div class="flex gap-2">
        <dt class="shrink-0 text-gold-100/55">定休日</dt>
        <dd class="truncate">{regularHoliday}</dd>
      </div>
      <div class="flex gap-2">
        <dt class="shrink-0 text-gold-100/55">予算</dt>
        <dd class="truncate">{budget}</dd>
      </div>
    </dl>
    <div class="mt-auto flex flex-wrap gap-1.5 pt-2">
      {vibes.slice(0, 3).map((vibe) => <Badge label={vibe} />)}
    </div>
  </div>
</a>
