---
import Badge from './Badge.astro';
import GenreIcon from './GenreIcon.astro';
import OpenStatus from './OpenStatus.astro';
import { Play } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';
import { isRecentlyPublished } from '../lib/spotFreshness';
import { isShinise } from '../lib/shinise';

interface Props {
  spot: CollectionEntry<'spots'>;
  /** 一覧内での並び順。指定するとスクロールで時間差をつけて浮かび上がる
   *  （global.cssの[data-reveal]参照）。以下のような、IntersectionObserver
   *  の前提（「要素は通常のブロックとして、いずれ画面内に大きく入ってくる」）
   *  が崩れる一覧では指定しないこと。指定すると不透明度0のまま固まって
   *  消えて見える不具合になる:
   *  - /spots/のようにJSでカードの表示・非表示を切り替えるフィルタ付き
   *    一覧（display:noneの間は交差判定できない）
   *  - index.astroのSPOTSのような横スクロール行（2枚目以降は右端に
   *    「一部だけ覗く」状態が初期表示になり、面積の交差率が
   *    SectionHeading.astro側のthreshold:0.2を永遠に超えられない） */
  revealIndex?: number;
}

const { spot, revealIndex } = Astro.props;
const {
  title,
  genre,
  budget,
  budgetMin,
  budgetMax,
  openHours,
  regularHoliday,
  vibes,
  hours,
  isIrregular,
  description,
  youtubeVideos,
  pubDate,
  establishedYear,
  placeId,
} = spot.data;
const hasVideo = (youtubeVideos?.length ?? 0) > 0;
const showNewBadge = isRecentlyPublished(pubDate);
const showShiniseBadge = isShinise(establishedYear);

// 営業時間の表示方針（2026年9月、一覧カードと詳細ページの表示が食い違う
// という指摘を受けて整理）:
// - hours（構造化営業時間）があれば、従来通りopenHours/regularHolidayの
//   テキストとOpenStatusバッジ（開店中/まもなく閉店等）を表示する。
// - hoursが無くてもplaceIdがあれば、詳細ページではLivePlaceHours.astroが
//   Google Place Detailsをその場でライブ取得して正しい営業時間を表示できる
//   （2026年9月以降、Agent1が営業時間を収集しなくなったため新規記事は
//   基本的にこちらに該当する）。一覧カードはコスト上ライブ取得をしない
//   （店舗数×閲覧数ぶんAPI呼び出しが増えるため）ので、「店舗へ要確認」
//   という実際より弱い言い方はせず、「詳細ページでご確認ください」と
//   案内する。今営業中/まもなく閉店のようなリアルタイム判定はカード単体
//   では行えないため、OpenStatusバッジ自体は表示しない（不正確な
//   「要確認」バッジを出すより、何も出さない方が誤解を招かない）。
// - hoursもplaceIdも無い場合（例: beerhouse3.mdのようにPlace ID解決が
//   必須になる前の記事）は、案内できる詳細ページ側の情報も無いため、
//   従来通り「店舗へ要確認」＋unknown状態のOpenStatusバッジを表示する。
const hasConfirmedHours = Boolean(hours);
const canConfirmOnDetailPage = !hasConfirmedHours && Boolean(placeId);
---

<a
  href={`/spots/${spot.id}/`}
  data-spot-card
  data-genre={genre}
  data-vibes={vibes.join('|')}
  data-hours={JSON.stringify(hours ?? null)}
  data-budget-min={budgetMin ?? ''}
  data-budget-max={budgetMax ?? ''}
  data-has-video={hasVideo ? '1' : ''}
  data-reveal={revealIndex !== undefined ? true : undefined}
  style={revealIndex !== undefined ? `--reveal-i:${revealIndex}` : undefined}
  class="group relative flex flex-col overflow-hidden rounded-xl border border-night-700 bg-night-900/80 shadow-lg shadow-black/30 transition duration-300 hover:-translate-y-0.5 hover:border-amber-deep/70 hover:shadow-amber-deep/10"
>
  <div class="flex items-center justify-between gap-2 border-b border-night-700 bg-night-800/50 px-4 py-3">
    <span class="inline-flex items-center gap-1.5 text-xs font-medium tracking-wide text-amber-glow">
      <GenreIcon genre={genre} size={14} />
      {genre}
    </span>
    <div class="flex flex-wrap items-center justify-end gap-1.5">
      {
        hasVideo && (
          <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-vermilion/15 px-2 py-0.5 text-[0.65rem] font-semibold text-vermilion">
            <Play size={10} class="fill-vermilion" aria-hidden="true" />
            動画あり
          </span>
        )
      }
      {
        showNewBadge && (
          <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-vermilion px-2.5 py-1 text-[0.65rem] font-bold tracking-wide text-white shadow-lg shadow-vermilion/40">
            <span class="lantern-breathe h-1.5 w-1.5 rounded-full bg-white" />
            NEW
          </span>
        )
      }
      {
        showShiniseBadge && (
          <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-amber-deep px-2.5 py-1 text-[0.65rem] font-bold tracking-wide text-white shadow-lg shadow-amber-deep/40">
            老舗
          </span>
        )
      }
    </div>
  </div>
  <div class="flex flex-1 flex-col gap-3 px-4 py-4">
    <h3
      class="font-serif text-xl font-bold text-gold-100 transition group-hover:text-amber-glow"
    >
      {title}
    </h3>
    <p class="line-clamp-2 text-sm leading-relaxed text-gold-100/60">
      {description}
    </p>
    <dl class="mt-1 space-y-1 text-xs text-gold-100/50">
      {
        canConfirmOnDetailPage ? (
          <div class="flex gap-2">
            <dt class="shrink-0 text-gold-100/55">営業時間</dt>
            <dd class="min-w-0 flex-1 truncate">詳細ページでご確認ください</dd>
          </div>
        ) : (
          <Fragment>
            <div class="flex items-center gap-2">
              <dt class="shrink-0 text-gold-100/55">営業時間</dt>
              <dd class="min-w-0 flex-1 truncate">{openHours}</dd>
              <OpenStatus hours={hours} isIrregular={isIrregular} size="sm" />
            </div>
            <div class="flex gap-2">
              <dt class="shrink-0 text-gold-100/55">定休日</dt>
              <dd class="truncate">{regularHoliday}</dd>
            </div>
          </Fragment>
        )
      }
      <div class="flex gap-2">
        <dt class="shrink-0 text-gold-100/55">予算</dt>
        <dd class="truncate">{budget}</dd>
      </div>
    </dl>
    <div class="mt-auto flex flex-wrap gap-1.5 pt-2">
      {vibes.slice(0, 3).map((vibe) => <Badge label={vibe} />)}
    </div>
  </div>
</a>
