---
interface Props {
  icon: any;
  label: string;
  accent?: 'amber' | 'vermilion';
}

const { icon: Icon, label, accent = 'amber' } = Astro.props;

const ACCENT_CLASS: Record<string, string> = {
  amber: 'border-amber-deep/50 bg-amber-glow/10 text-amber-glow',
  vermilion: 'border-vermilion/50 bg-vermilion/10 text-vermilion',
};

const LABEL_CLASS: Record<string, string> = {
  amber: 'text-amber-glow/70',
  vermilion: 'text-vermilion/80',
};
---

<div class="flex items-center gap-3">
  <span
    class:list={[
      'inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border',
      ACCENT_CLASS[accent],
    ]}
  >
    <Icon size={18} stroke-width={1.75} aria-hidden="true" />
  </span>
  <div>
    <p class:list={['text-[0.65rem] tracking-[0.25em]', LABEL_CLASS[accent]]}>{label}</p>
    <h2 class="mt-0.5 font-serif text-xl font-bold text-gold-100 sm:text-2xl">
      <slot />
    </h2>
  </div>
</div>
