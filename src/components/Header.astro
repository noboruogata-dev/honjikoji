---
import Logo from './Logo.astro';

interface Props {
  showBackLink?: boolean;
  /** showBackLink=true のときの戻り先。ページごとの一覧に戻す。 */
  backHref?: string;
}
const { showBackLink = false, backHref = '/' } = Astro.props;

const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/spots/', label: '店舗一覧', active: pathname.startsWith('/spots') },
  { href: '/news/', label: 'ニュース', active: pathname.startsWith('/news') },
  { href: '/about/', label: '本寺小路について', active: pathname.startsWith('/about') },
];
---

<header class="relative overflow-hidden border-b border-night-700 bg-night-900">
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_60%_80%_at_50%_0%,rgba(242,181,68,0.12),transparent),radial-gradient(ellipse_40%_60%_at_100%_0%,rgba(226,71,47,0.08),transparent)]"
  >
  </div>
  <div class="relative mx-auto max-w-5xl px-4 py-8 sm:py-10">
    {
      showBackLink && (
        <a
          href={backHref}
          class="mb-4 inline-flex items-center gap-1 text-sm text-gold-100/70 transition hover:text-amber-glow"
        >
          ← 一覧に戻る
        </a>
      )
    }
    <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="inline-block">
          <Logo size="lg" showTagline />
        </h1>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-gold-100/60">
          新潟県三条市の歓楽街「本寺小路」――灯りの点る路地に集う、飲食店・店舗のご案内。
        </p>
      </div>

      <nav aria-label="サイトナビゲーション" class="flex shrink-0 flex-wrap gap-2">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              aria-current={link.active ? 'page' : undefined}
              class:list={[
                'rounded-full border px-3.5 py-1.5 text-xs font-medium transition',
                link.active
                  ? 'border-amber-deep bg-amber-glow text-night-950'
                  : 'border-night-600 bg-night-800/60 text-gold-100/70 hover:border-amber-deep/60 hover:text-amber-glow',
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>
