---
/**
 * src/components/OmikujiButton.astro
 *
 * 全ページ共通の「本寺小路おみくじ」フローティングボタン＋モーダル。
 * Layout.astro に1箇所だけ配置する（transition:persistでページ遷移を
 * またいで同一DOMを保つ）。
 *
 * モーダルの開閉・Escape・背景クリック・スクロールロック・
 * astro:page-load再初期化は、Header.astroのモバイルメニュー
 * （ネイティブ<dialog>＋showModal()）と同じ実績あるパターンを踏襲する。
 * showModal()はブラウザが自動でトップレイヤー描画とフォーカストラップを
 * 提供するため、フォーカストラップを自前実装する必要はない。
 */
import LanternIcon from './illustrations/LanternIcon.astro';
import { X } from '@lucide/astro';
---

<div transition:persist transition:name="omikuji-widget">
  <div
    class="fixed right-4 z-40 flex items-center gap-2"
    style="bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));"
  >
    <div
      data-omikuji-hint
      aria-hidden="true"
      class="omikuji-hint pointer-events-none whitespace-nowrap rounded-full bg-night-800 px-3 py-1.5 text-xs font-medium text-gold-100 shadow-[0_4px_14px_rgba(8,9,15,0.4)]"
    >
      運試し
    </div>

    <button
      type="button"
      data-omikuji-open
      aria-haspopup="dialog"
      aria-controls="omikuji-dialog"
      aria-label="今夜のおみくじを引く"
      class="inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-full border border-amber-deep/50 bg-night-900/90 text-amber-glow shadow-[0_4px_20px_rgba(8,9,15,0.45)] backdrop-blur-sm transition hover:border-amber-glow/70 hover:bg-night-800"
    >
      <span data-omikuji-fab-icon class="inline-flex">
        <LanternIcon size={28} lit={true} />
      </span>
      <span class="sr-only">今夜のおみくじを引く</span>
    </button>
  </div>

  <dialog
    id="omikuji-dialog"
    data-omikuji-dialog
    aria-label="今夜のおみくじ"
    class="omikuji-dialog m-auto max-h-[90dvh] w-[min(92vw,26rem)] overflow-y-auto border-0 bg-transparent p-0 backdrop:bg-night-950/80"
  >
    <div class="omikuji-panel relative rounded-2xl border border-night-700 bg-night-900 px-6 py-8 text-center shadow-[0_20px_60px_rgba(8,9,15,0.6)]">
      <button
        type="button"
        data-omikuji-close
        aria-label="閉じる"
        class="absolute right-3 top-3 inline-flex h-9 w-9 items-center justify-center rounded-full text-gold-100/60 transition hover:bg-night-800 hover:text-amber-glow"
      >
        <X size={19} stroke-width={1.7} aria-hidden="true" />
      </button>

      <p class="text-xs tracking-[0.3em] text-amber-glow/70">本寺小路おみくじ</p>

      <div data-omikuji-lanterns class="mt-5 flex flex-wrap items-center justify-center gap-1.5" aria-hidden="true">
      </div>

      <div data-omikuji-result class="mt-2" aria-live="polite"></div>

      <p data-omikuji-note class="mt-5 text-xs leading-relaxed text-gold-100/45"></p>
    </div>
  </dialog>

  <template data-omikuji-lantern-template><LanternIcon size={30} class="omikuji-lantern" /></template>
</div>

<script>
  import {
    draw,
    getOmikujiDayKey,
    OMIKUJI_RANKS,
    type OmikujiRank,
    type OmikujiResult,
  } from '../lib/omikuji';

  const STORAGE_KEY = 'honjikoji-omikuji';

  // 「運試し」吹き出しの表示方針。A/Bどちらも実装済みで、ここを書き換える
  // だけで切り替えられる。
  //   'auto-hide' : ページ読み込み後に数秒表示して自動で引っ込む（既定・推奨）。
  //                 タップ可能であることだけ伝え、閲覧の邪魔をしない。
  //                 astro:page-loadのたびに再表示されるため、初見の説明としての
  //                 役割は毎回保たれる。
  //   'always'    : 常時表示（引くまでずっと出したままにする）。
  // どちらのモードでも、実際に引いた後は即座に隠す（A/B共通の要件）。
  const HINT_DISPLAY_MODE: 'auto-hide' | 'always' = 'auto-hide';
  const HINT_AUTO_HIDE_MS = 4500;

  const LANTERN_STAGGER_MS = 150;
  // .omikuji-lanternのtransition-duration（下のstyle参照）と合わせてある。
  const LANTERN_ENTER_MS = 280;
  // 「主」は一斉に・より速く灯す（.omikuji-lantern.is-rareだけ短いdurationにしてある）。
  const RARE_ENTER_MS = 200;
  const RESULT_BUFFER_MS = 150;

  interface StoredDraw {
    dateKey: string;
    rankKey: string;
    text: string;
  }

  /** localStorageが使えない環境（プライベートブラウジング等）でも
   *  機能自体は止めない。読み書き失敗時はnull/no-opにフォールバックする。 */
  function readStoredDraw(): StoredDraw | null {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw);
      if (
        parsed &&
        typeof parsed.dateKey === 'string' &&
        typeof parsed.rankKey === 'string' &&
        typeof parsed.text === 'string'
      ) {
        return parsed as StoredDraw;
      }
      return null;
    } catch {
      return null;
    }
  }

  function writeStoredDraw(value: StoredDraw) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(value));
    } catch {
      // 保存できなくても、今回の結果はこのセッション内で表示できていれば十分。
    }
  }

  function findRank(rankKey: string): OmikujiRank | undefined {
    return OMIKUJI_RANKS.find((r) => r.key === rankKey);
  }

  let controller: AbortController | undefined;

  function initOmikuji() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const openButton = document.querySelector<HTMLButtonElement>('[data-omikuji-open]');
    const fabIconWrapper = document.querySelector<HTMLElement>('[data-omikuji-fab-icon]');
    const fabLantern = fabIconWrapper?.querySelector<SVGElement>('.lantern-icon');
    const hintEl = document.querySelector<HTMLElement>('[data-omikuji-hint]');
    const dialog = document.querySelector<HTMLDialogElement>('[data-omikuji-dialog]');
    const closeButton = dialog?.querySelector<HTMLButtonElement>('[data-omikuji-close]');
    const lanternsEl = document.querySelector<HTMLElement>('[data-omikuji-lanterns]');
    const resultEl = document.querySelector<HTMLElement>('[data-omikuji-result]');
    const noteEl = document.querySelector<HTMLElement>('[data-omikuji-note]');
    const lanternTemplate = document.querySelector<HTMLTemplateElement>('[data-omikuji-lantern-template]');
    if (
      !openButton ||
      !fabLantern ||
      !hintEl ||
      !dialog ||
      !closeButton ||
      !lanternsEl ||
      !resultEl ||
      !noteEl ||
      !lanternTemplate
    ) {
      return;
    }

    const prefersReducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let hintHideTimer: ReturnType<typeof setTimeout> | undefined;

    // 「今日まだ引いていない」間だけFABが目を引く演出をする
    // （.is-inviting＝強めの呼吸＋微かな揺れ＋稀な一瞬の風のような揺らぎ。
    // 点滅はしない。詳細はsrc/styles/global.css参照）。FAB自体は常に
    // lit={true}（点灯した見た目）で、このクラスの有無だけを切り替える。
    // 「運試し」の吹き出しも同じ条件で出す。表示方針はHINT_DISPLAY_MODEで
    // 切り替える。すでに引いた後は、A/Bどちらのモードでも
    // （auto-hideのフェード待ち中であっても）即座に隠す。
    function syncFabState() {
      const today = readStoredDraw();
      const hasDrawnToday = today?.dateKey === getOmikujiDayKey();
      fabLantern!.classList.toggle('is-inviting', !hasDrawnToday);

      if (hintHideTimer !== undefined) {
        clearTimeout(hintHideTimer);
        hintHideTimer = undefined;
      }
      if (hasDrawnToday) {
        hintEl!.classList.remove('is-visible');
        return;
      }

      requestAnimationFrame(() => hintEl!.classList.add('is-visible'));
      if (HINT_DISPLAY_MODE === 'auto-hide') {
        hintHideTimer = setTimeout(() => hintEl!.classList.remove('is-visible'), HINT_AUTO_HIDE_MS);
      }
      // 'always' モードでは何もタイマーを仕掛けない＝引くまで表示され続ける。
    }
    syncFabState();

    function cloneLantern(): SVGElement {
      return lanternTemplate!.content.firstElementChild!.cloneNode(true) as SVGElement;
    }

    function buildLanternSlots(): SVGElement[] {
      lanternsEl!.innerHTML = '';
      const slots: SVGElement[] = [];
      for (let i = 0; i < 7; i++) {
        const el = cloneLantern();
        lanternsEl!.appendChild(el);
        slots.push(el);
      }
      return slots;
    }

    // お告げ本文が主役、格付け名・出現率は補助情報という序列にする:
    // 格付け名は小さく落ち着いた色に、本文は専用の面（night-800）に載せて
    // 余白を広く取り、そこだけが浮かび上がるようにする。
    function renderResult(result: OmikujiResult) {
      const { rank, text } = result;
      resultEl!.innerHTML = `
        <p class="font-serif text-base font-bold text-gold-100/75">${rank.name}</p>
        <p class="mt-0.5 text-[0.65rem] tracking-[0.15em] text-gold-100/40">${rank.reading}</p>
        <div class="mx-auto mt-5 max-w-[24em] rounded-xl border border-gold-100/10 bg-night-800 px-5 py-7">
          <p class="font-serif text-xl font-semibold leading-[2] text-gold-100">${text}</p>
        </div>
        <p class="mt-4 text-[0.65rem] text-gold-100/35">${rank.phrase}（出現率：約${rank.weight}%）</p>
      `;
    }

    /** アニメーション無し・最終状態を即座に反映する（同日再表示・reduced-motion用）。 */
    function showStatic(result: OmikujiResult) {
      const slots = buildLanternSlots();
      const litCount = result.rank.rare ? 7 : result.rank.lanternCount;
      slots.forEach((slot, i) => {
        if (result.rank.rare) {
          slot.classList.add('is-lit', 'is-rare');
        } else {
          slot.classList.add(i < litCount ? 'is-lit' : 'is-unlit');
        }
      });
      renderResult(result);
    }

    /** 「提灯が奥から手前へ順に灯る」演出。全体で1.5秒以内。
     *  is-lit/is-unlit/is-rareを付けるだけで、出現（.omikuji-lantern側）と
     *  点灯・消灯の色（LanternIcon側、src/styles/global.css）の両方が
     *  自動的にtransitionする。 */
    function playReveal(result: OmikujiResult) {
      const slots = buildLanternSlots();
      resultEl!.innerHTML = '';

      if (result.rank.rare) {
        // 「主」だけ演出を変える: 順番にではなく一斉に、朱色で強く。
        slots.forEach((slot) => {
          slot.classList.add('is-lit', 'is-rare');
        });
        window.setTimeout(() => renderResult(result), RARE_ENTER_MS + RESULT_BUFFER_MS);
        return;
      }

      const litCount = result.rank.lanternCount;
      slots.forEach((slot, i) => {
        window.setTimeout(() => {
          slot.classList.add(i < litCount ? 'is-lit' : 'is-unlit');
        }, i * LANTERN_STAGGER_MS);
      });
      const totalMs = (slots.length - 1) * LANTERN_STAGGER_MS + LANTERN_ENTER_MS + RESULT_BUFFER_MS;
      window.setTimeout(() => renderResult(result), totalMs);
    }

    function showAlreadyDrawn(stored: StoredDraw) {
      const rank = findRank(stored.rankKey);
      if (!rank) return; // 万一データが壊れていたら何もしない（安全側）。
      showStatic({ rank, text: stored.text });
      noteEl!.textContent = '今日のお告げは、もう出ています。次の灯りは明朝六時に。';
    }

    function drawAndShow() {
      const result = draw();
      writeStoredDraw({ dateKey: getOmikujiDayKey(), rankKey: result.rank.key, text: result.text });
      noteEl!.textContent = '';
      if (prefersReducedMotion()) {
        showStatic(result);
      } else {
        playReveal(result);
      }
      syncFabState();
    }

    openButton.addEventListener(
      'click',
      () => {
        dialog.showModal();
        document.body.style.overflow = 'hidden';
        closeButton.focus();

        const today = readStoredDraw();
        if (today?.dateKey === getOmikujiDayKey()) {
          showAlreadyDrawn(today);
        } else {
          noteEl!.textContent = '';
          drawAndShow();
        }
      },
      { signal }
    );

    function closeDialog() {
      if (!dialog!.open) return;
      dialog!.close();
      document.body.style.overflow = '';
      openButton!.focus();
    }

    closeButton.addEventListener('click', closeDialog, { signal });
    dialog.addEventListener(
      'cancel',
      (event) => {
        event.preventDefault();
        closeDialog();
      },
      { signal }
    );
    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape' && dialog.open) {
          event.preventDefault();
          closeDialog();
        }
      },
      { signal }
    );
    dialog.addEventListener(
      'click',
      (event) => {
        if (event.target === dialog) closeDialog();
      },
      { signal }
    );
  }

  document.addEventListener('astro:page-load', initOmikuji);
</script>

<style>
  .omikuji-dialog[open] {
    display: block;
  }

  /* 「運試し」の吹き出し。ボタンの左に付く右向きの三角をborderトリックで
     作る（吹き出しの背景色bg-night-800と同じ色をborder-leftに使う）。
     transform/opacityのみでフェード（制約どおり）。 */
  .omikuji-hint {
    position: relative;
    opacity: 0;
    transform: translateX(6px);
    transition: opacity 240ms ease, transform 240ms ease;
  }
  .omikuji-hint.is-visible {
    opacity: 1;
    transform: translateX(0);
  }
  .omikuji-hint::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -6px;
    transform: translateY(-50%);
    border-style: solid;
    border-width: 6px 0 6px 7px;
    border-color: transparent transparent transparent var(--color-night-800);
  }

  @media (prefers-reduced-motion: reduce) {
    .omikuji-hint {
      transition: none;
    }
  }

  /* 提灯スロット: 点灯/消灯・「主」の色やグローはLanternIcon側
     （src/styles/global.css の .lantern-icon.is-lit 等）が担当する。
     ここでは「出現」だけを扱う: JSがis-lit/is-unlit/is-rareのいずれかを
     付けるまでは不可視で、付いた瞬間にtransform/opacityがフェードインする
     （LanternIcon側のfill/filterのtransitionと同時に走るため、
     「灯る」演出として一体に見える）。「主」だけ短いdurationにして
     一斉点灯を素早く見せる。 */
  :global(.omikuji-lantern) {
    opacity: 0;
    transform: scale(0.7);
    transition: opacity 280ms ease-out, transform 280ms ease-out;
  }
  :global(.omikuji-lantern.is-lit),
  :global(.omikuji-lantern.is-unlit),
  :global(.omikuji-lantern.is-rare) {
    opacity: 1;
    transform: scale(1);
  }
  :global(.omikuji-lantern.is-rare) {
    transition-duration: 200ms;
  }

  @media (prefers-reduced-motion: reduce) {
    /* JS側もprefers-reduced-motionを見てplayRevealを呼ばない設計だが、
       CSSレイヤーでも二重に無効化しておく（他の演出と同じ防御的な方針）。 */
    :global(.omikuji-lantern) {
      transition: none;
    }
  }
</style>
