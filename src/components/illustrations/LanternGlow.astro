---
// 提灯の柔らかな光と、焼肉・焼き鳥の煙情景を模したイラスト。
// カード背景やコラムのアクセントとして使う正方形寄りのミニイラスト。

interface Props {
  class?: string;
}

const { class: className = 'w-full h-auto' } = Astro.props;
const uid = Math.random().toString(36).slice(2, 9);
---

<svg viewBox="0 0 260 260" fill="none" class={className} aria-hidden="true">
  <defs>
    <radialGradient id={`bloom-${uid}`} cx="50%" cy="42%" r="55%">
      <stop offset="0%" stop-color="var(--color-amber-glow)" stop-opacity="0.5" />
      <stop offset="60%" stop-color="var(--color-amber-glow)" stop-opacity="0.12" />
      <stop offset="100%" stop-color="var(--color-amber-glow)" stop-opacity="0" />
    </radialGradient>
    <radialGradient id={`lantern-${uid}`} cx="50%" cy="32%" r="65%">
      <stop offset="0%" stop-color="var(--color-amber-glow)" />
      <stop offset="55%" stop-color="var(--color-amber-deep)" />
      <stop offset="100%" stop-color="var(--color-vermilion)" />
    </radialGradient>
    <linearGradient id={`smoke-${uid}`} x1="0" y1="1" x2="0" y2="0">
      <stop offset="0%" stop-color="var(--color-gold-100)" stop-opacity="0.22" />
      <stop offset="100%" stop-color="var(--color-gold-100)" stop-opacity="0" />
    </linearGradient>
  </defs>

  <!-- 光の滲み -->
  <circle cx="130" cy="110" r="120" fill={`url(#bloom-${uid})`} />

  <!-- 煙（焼肉・焼き鳥の情景） -->
  <g stroke={`url(#smoke-${uid})`} stroke-width="10" stroke-linecap="round" fill="none" opacity="0.8">
    <path d="M70 240 C55 200 90 190 78 155 C68 128 100 118 90 90" />
    <path d="M180 240 C195 205 165 192 178 160 C188 135 158 122 172 95" />
  </g>

  <!-- 吊り紐 -->
  <line x1="130" y1="38" x2="130" y2="52" stroke="var(--color-night-500)" stroke-width="1.5" />
  <rect x="123" y="50" width="14" height="6" rx="2" fill="var(--color-night-600)" />

  <!-- 上キャップ -->
  <path d="M96 60 L164 60 L150 74 L110 74 Z" fill="var(--color-vermilion-deep)" />

  <!-- 提灯本体 -->
  <path
    d="M104 74 C82 96 82 158 104 182 L156 182 C178 158 178 96 156 74 Z"
    fill={`url(#lantern-${uid})`}
    stroke="var(--color-night-950)"
    stroke-opacity="0.3"
    stroke-width="1.5"
  />

  <!-- 骨（横線） -->
  <line x1="86" y1="96" x2="174" y2="96" stroke="var(--color-night-950)" stroke-opacity="0.25" stroke-width="1.5" />
  <line x1="80" y1="120" x2="180" y2="120" stroke="var(--color-night-950)" stroke-opacity="0.25" stroke-width="1.5" />
  <line x1="80" y1="144" x2="180" y2="144" stroke="var(--color-night-950)" stroke-opacity="0.25" stroke-width="1.5" />
  <line x1="86" y1="166" x2="174" y2="166" stroke="var(--color-night-950)" stroke-opacity="0.25" stroke-width="1.5" />

  <!-- 下キャップ・房 -->
  <path d="M110 182 L150 182 L164 198 L96 198 Z" fill="var(--color-vermilion-deep)" />
  <line x1="130" y1="198" x2="130" y2="214" stroke="var(--color-night-500)" stroke-width="1.5" />
  <circle cx="130" cy="217" r="4" fill="var(--color-amber-glow)" />
</svg>
