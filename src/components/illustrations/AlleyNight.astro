---
// 夜の小路・石畳・暖簾・街灯をモチーフにしたワイドイラスト。
// Hero や特集バナーの背景/アクセントとして、外部画像の代わりに使う軽量インラインSVG。
// 呼び出し側で class（配置・不透明度・サイズ）を制御できるよう、装飾色のみここで完結させる。
//
// [data-time] に応じて --sky-top/--sky-bottom/--glow（global.css定義）が変わり、
// 空のグラデーションと街灯のグローだけがそれに追随する（建物・暖簾など他の色は不変）。
//
// 街灯の点灯タイミングは ignite props で2種類から選べる:
//   'scroll'（既定） … 特集バナーで使用中。スクロール連動（animation-timeline: view()）。
//   'load'           … Heroで使用。ページ読み込み後、奥から手前へ1.5秒以内で点灯する
//                       （下部scriptがセッション中の初回のみ再生を制御）。

interface Props {
  class?: string;
  ignite?: 'scroll' | 'load';
}

const { class: className = 'w-full h-auto', ignite = 'scroll' } = Astro.props;
const uid = Math.random().toString(36).slice(2, 9);

// 建物のシルエット（連続する軒先）。x座標が隙間なく続くよう幅の合計を1200に揃えてある。
const buildings = [
  { x: 0, w: 150, h: 170 },
  { x: 150, w: 120, h: 230 },
  { x: 270, w: 160, h: 150 },
  { x: 430, w: 110, h: 260 },
  { x: 540, w: 150, h: 180 },
  { x: 690, w: 130, h: 230 },
  { x: 820, w: 170, h: 160 },
  { x: 990, w: 120, h: 210 },
  { x: 1110, w: 90, h: 180 },
];

// 街灯（提灯）。奥（左・xが小さい）から手前（右）へ並ぶ想定で、
// 揺れの周期・遅延・スクロール点灯のタイミングをすべて1灯ごとにずらす。
const lanterns = [
  { x: 110, swayDuration: 3.8, swayDelay: -0.6 },
  { x: 405, swayDuration: 4.2, swayDelay: -1.7 },
  { x: 700, swayDuration: 5.1, swayDelay: -0.3 },
  { x: 995, swayDuration: 4.6, swayDelay: -2.4 },
];
---

<svg
  viewBox="0 0 1200 360"
  fill="none"
  class={className}
  aria-hidden="true"
  preserveAspectRatio="xMidYMax slice"
  data-ignite={ignite}
>
  <defs>
    <linearGradient id={`sky-${uid}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" style="stop-color: var(--sky-top)" />
      <stop offset="100%" style="stop-color: var(--sky-bottom)" />
    </linearGradient>
    <radialGradient id={`glow-${uid}`} cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color: var(--glow)" />
      <stop offset="100%" style="stop-color: var(--glow); stop-opacity: 0" />
    </radialGradient>
    <radialGradient id={`lantern-${uid}`} cx="50%" cy="35%" r="65%">
      <stop offset="0%" stop-color="var(--color-amber-glow)" />
      <stop offset="100%" stop-color="var(--color-vermilion)" />
    </radialGradient>
    <linearGradient id={`ground-${uid}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="var(--color-amber-glow)" stop-opacity="0.22" />
      <stop offset="100%" stop-color="var(--color-amber-glow)" stop-opacity="0" />
    </linearGradient>
  </defs>

  <!-- 空（時間帯で色が変わる背景レイヤー） -->
  <rect x="0" y="0" width="1200" height="360" fill={`url(#sky-${uid})`} />

  <!-- 建物のシルエット -->
  {
    buildings.map((b, i) => (
      <rect
        x={b.x}
        y={360 - b.h}
        width={b.w}
        height={b.h}
        fill="var(--color-night-800)"
        fill-opacity={i % 2 === 0 ? 0.95 : 0.75}
      />
    ))
  }

  <!-- 暖簾（のれん） -->
  <g fill="var(--color-vermilion-deep)" fill-opacity="0.55">
    <rect x="300" y="300" width="70" height="50" rx="2" />
    <rect x="860" y="290" width="80" height="55" rx="2" />
  </g>
  <g stroke="var(--color-night-950)" stroke-opacity="0.4" stroke-width="2">
    <line x1="335" y1="300" x2="335" y2="350" />
    <line x1="900" y1="290" x2="900" y2="345" />
  </g>

  <!-- 石畳の照り返し -->
  <rect x="0" y="340" width="1200" height="20" fill={`url(#ground-${uid})`} />
  <g stroke="var(--color-night-700)" stroke-opacity="0.4" stroke-width="1">
    {Array.from({ length: 29 }).map((_, i) => (
      <line x1={i * 42} y1="345" x2={i * 42 + 10} y2="360" />
    ))}
  </g>

  <!-- 街灯（提灯）: グロー・ポールは固定、提灯本体+骨だけが揺れる -->
  {
    lanterns.map((lantern, i) => {
      const x = lantern.x;
      return (
        <g>
          <circle
            cx={x}
            cy={258}
            r={46}
            fill={`url(#glow-${uid})`}
            class="street-glow"
            data-index={i}
          />
          <line x1={x} y1="360" x2={x} y2="270" stroke="var(--color-night-600)" stroke-width="3" />
          <g
            class="lantern-sway"
            style={`animation-duration:${lantern.swayDuration}s;animation-delay:${lantern.swayDelay}s;`}
          >
            <path
              d={`M${x - 12} 258 C${x - 16} 268 ${x - 16} 282 ${x - 12} 292 L${x + 12} 292 C${x + 16} 282 ${x + 16} 268 ${x + 12} 258 Z`}
              fill={`url(#lantern-${uid})`}
              stroke="var(--color-night-950)"
              stroke-opacity="0.3"
              stroke-width="1"
            />
            <line x1={x - 12} y1="269" x2={x + 12} y2="269" stroke="var(--color-night-950)" stroke-opacity="0.25" />
            <line x1={x - 14} y1="280" x2={x + 14} y2="280" stroke="var(--color-night-950)" stroke-opacity="0.25" />
          </g>
        </g>
      );
    })
  }
</svg>

<style>
  /* 提灯の揺れ: transform-boxを指定しないとSVGでは"top center"のような
     キーワード指定が要素のfill-boxではなくviewport基準になってしまう。 */
  .lantern-sway {
    transform-box: fill-box;
    transform-origin: top center;
    animation-name: lantern-sway;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }
  @keyframes lantern-sway {
    0%,
    100% {
      transform: rotate(-1.5deg);
    }
    50% {
      transform: rotate(1.5deg);
    }
  }

  /* スクロール連動点灯（ignite="scroll"、既定＝特集バナー用）。
     非対応ブラウザ/実装向けの既定値は @supports の外側に書き、
     「最初から点灯済み」を保証する（JS不使用）。
     ignite="load"（Hero用）のインスタンスには適用しない。 */
  svg:not([data-ignite="load"]) .street-glow {
    opacity: 1;
  }

  @supports (animation-timeline: view()) {
    svg:not([data-ignite="load"]) .street-glow {
      opacity: 0;
      animation-name: lantern-light-up;
      animation-timeline: view();
      animation-fill-mode: both;
    }
    @keyframes lantern-light-up {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
    /* 奥（xが小さい=index 0）から手前へ、点灯するタイミングを少しずつ遅らせる。 */
    svg:not([data-ignite="load"]) .street-glow[data-index="0"] {
      animation-range: entry 0% entry 40%;
    }
    svg:not([data-ignite="load"]) .street-glow[data-index="1"] {
      animation-range: entry 15% entry 55%;
    }
    svg:not([data-ignite="load"]) .street-glow[data-index="2"] {
      animation-range: entry 30% entry 70%;
    }
    svg:not([data-ignite="load"]) .street-glow[data-index="3"] {
      animation-range: entry 45% entry 85%;
    }
  }

  /* 読み込み時点灯（ignite="load"、Hero用）。JS（下部の<script>）が
     "is-igniting"（初回・点灯アニメーション再生）か "is-lit"（2回目以降・
     即全点灯）のいずれかのクラスをsvg要素に付与する。
     prefers-reduced-motionでの「最初から全点灯」はglobal.cssの既存ルール
     （.street-glow に animation:none/opacity:1 を !important で強制）が
     scroll/loadどちらのモードにも効くため、ここでは何もしなくてよい。 */
  [data-ignite="load"] .street-glow {
    opacity: 0.18; /* JS実行前・JS無効時の既定値: 暗いが真っ暗ではない */
  }
  [data-ignite="load"].is-lit .street-glow {
    opacity: 1; /* 遷移なし・即座に全点灯（再生済みセッションでの再訪問時） */
  }
  [data-ignite="load"].is-igniting .street-glow {
    animation: lantern-ignite 550ms ease-out forwards;
  }
  [data-ignite="load"].is-igniting .street-glow[data-index="0"] {
    animation-delay: 0ms;
  }
  [data-ignite="load"].is-igniting .street-glow[data-index="1"] {
    animation-delay: 250ms;
  }
  [data-ignite="load"].is-igniting .street-glow[data-index="2"] {
    animation-delay: 500ms;
  }
  [data-ignite="load"].is-igniting .street-glow[data-index="3"] {
    animation-delay: 750ms;
  }
  @keyframes lantern-ignite {
    from {
      opacity: 0.18;
    }
    to {
      opacity: 1;
    }
  }
</style>

<script>
  // ページ読み込み後、ignite="load"のインスタンス（Hero）の街灯を
  // 奥から手前へ点灯させる。sessionStorageは使わず、モジュールスコープの
  // 変数で「このSPAセッション（ClientRouterでの遷移中）で再生済みか」を
  // 判定する（フルリロードでのみリセットされる＝セッション中の初回のみ再生）。
  // astro:page-loadは初回読み込み時にも発火するため、初期化はここに一本化する。
  let heroIntroPlayed = false;

  function initIgnite() {
    const targets = document.querySelectorAll<SVGSVGElement>('svg[data-ignite="load"]');
    if (targets.length === 0) return; // このページにHero版インスタンスが無ければ何もしない

    targets.forEach((svg) => {
      svg.classList.add(heroIntroPlayed ? 'is-lit' : 'is-igniting');
    });
    heroIntroPlayed = true;
  }

  document.addEventListener('astro:page-load', initIgnite);
</script>
