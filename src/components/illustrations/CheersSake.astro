---
// 乾杯する盃（お猪口）をモチーフにしたミニイラスト。
// ハシゴ酒・小路コラムのアクセントとして使う横長のワンポイント。

interface Props {
  class?: string;
}

const { class: className = 'w-full h-auto' } = Astro.props;
const uid = Math.random().toString(36).slice(2, 9);
---

<svg viewBox="0 0 220 150" fill="none" class={className} aria-hidden="true">
  <defs>
    <linearGradient id={`sake-${uid}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="var(--color-amber-glow)" />
      <stop offset="100%" stop-color="var(--color-amber-deep)" />
    </linearGradient>
    <radialGradient id={`spark-${uid}`} cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="var(--color-amber-glow)" stop-opacity="0.9" />
      <stop offset="100%" stop-color="var(--color-amber-glow)" stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- 乾杯の光の弾け -->
  <circle cx="110" cy="52" r="30" fill={`url(#spark-${uid})`} opacity="0.6" />
  <g stroke="var(--color-vermilion)" stroke-width="2.5" stroke-linecap="round" opacity="0.85">
    <line x1="110" y1="18" x2="110" y2="30" />
    <line x1="84" y1="30" x2="93" y2="38" />
    <line x1="136" y1="30" x2="127" y2="38" />
    <line x1="80" y1="52" x2="92" y2="52" />
    <line x1="140" y1="52" x2="128" y2="52" />
  </g>
  <circle cx="96" cy="20" r="2.5" fill="var(--color-amber-glow)" />
  <circle cx="126" cy="24" r="2" fill="var(--color-vermilion)" />

  <!-- 左の盃 -->
  <g transform="translate(70 108) rotate(-18)">
    <polygon points="-18,-34 18,-34 12,0 -12,0" fill="var(--color-night-800)" stroke="var(--color-night-950)" stroke-opacity="0.4" />
    <ellipse cx="0" cy="-30" rx="16" ry="4.5" fill={`url(#sake-${uid})`} />
    <line x1="-14" y1="-16" x2="10" y2="-16" stroke="var(--color-night-950)" stroke-opacity="0.2" />
  </g>

  <!-- 右の盃 -->
  <g transform="translate(150 108) rotate(18)">
    <polygon points="-18,-34 18,-34 12,0 -12,0" fill="var(--color-night-800)" stroke="var(--color-night-950)" stroke-opacity="0.4" />
    <ellipse cx="0" cy="-30" rx="16" ry="4.5" fill={`url(#sake-${uid})`} />
    <line x1="-10" y1="-16" x2="14" y2="-16" stroke="var(--color-night-950)" stroke-opacity="0.2" />
  </g>
</svg>
