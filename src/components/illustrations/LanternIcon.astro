---
// 小さな提灯の線画アイコン。AlleyNight.astroの提灯（バレル形状＋横リブ線）を
// 20px前後で潰れないよう簡略化したもの。色はcurrentColor任せにし、
// 「点灯/消灯」の区別はこのコンポーネントでは作らない（呼び出し側が
// text-*色・opacity・.lantern-icon-lit（グロー）クラスで表現する）。
//
// クライアントJSから複製して使う想定のため、index.astroでは<template>に
// 包んで1つだけレンダーし、script側でcloneNode(true)して個数分並べる
// （Astroコンポーネントはビルド時にしか展開できないため）。
interface Props {
  size?: number;
  class?: string;
}

const { size = 20, class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 20 28"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  class={className}
  aria-hidden="true"
>
  <line x1="6" y1="2" x2="14" y2="2" />
  <path d="M6 2C3.5 6 3.5 20 6 24h8c2.5-4 2.5-18 0-22" />
  <line x1="6" y1="24" x2="14" y2="24" />
  <line x1="4" y1="13" x2="16" y2="13" />
</svg>
