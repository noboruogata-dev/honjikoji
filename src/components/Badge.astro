---
interface Props {
  label: string;
  variant?: 'default' | 'solid';
  class?: string;
}

const { label, variant = 'default', class: className = '' } = Astro.props;
---

{
  variant === 'solid' ? (
    <span
      class:list={[
        'inline-flex items-center rounded-full bg-amber-glow px-2.5 py-1 text-xs font-semibold text-night-950',
        className,
      ]}
    >
      {label}
    </span>
  ) : (
    <span
      class:list={[
        'inline-flex items-center rounded-full border border-night-600 bg-night-800/60 px-2.5 py-1 text-xs text-gold-100/90',
        className,
      ]}
    >
      {label}
    </span>
  )
}
