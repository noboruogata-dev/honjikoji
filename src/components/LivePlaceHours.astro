---
// src/components/LivePlaceHours.astro
//
// 店舗詳細ページの「営業時間」「定休日」表示を、Place IDがあればGoogle Place
// Details (New) のライブ情報で上書きする。
//
// 設計方針（Google Maps Platform利用規約対応。詳細は functions/api/place-hours.ts
// のコメント参照）:
// - ビルド時にPlaces APIの内容を一切埋め込まない。ページ表示のたびに
//   /api/place-hours（Cloudflare Pages Function）経由でライブ取得する。
// - 取得成功時のみ、既存のopenHours/regularHoliday表示（data-static-open-hours /
//   data-static-regular-holiday を付けた要素）を隠し、Google由来の曜日別
//   テキストに完全に置き換える。矛盾する情報を同時に見せないため。
// - 取得失敗・placeId未設定・JS無効時は何もしない。既存のstatic表示が
//   そのまま残る（OpenStatus.astroと同じ「自信がなければ出さない」方針）。
interface Props {
  placeId?: string;
}

const { placeId } = Astro.props;
---

{
  placeId && (
    <div class="hidden bg-night-900 px-4 py-3 sm:col-span-2" data-live-place-hours data-place-id={placeId}>
      <dt class="text-xs text-gold-100/55">
        営業時間・定休日<span class="ml-1 text-gold-100/30">（Google Maps情報）</span>
      </dt>
      <dd class="mt-1 space-y-0.5 text-sm text-gold-100/85" data-live-place-hours-list />
    </div>
  )
}

<script>
  // weekdayDescriptions（Places APIが返す、曜日ごとの営業時間説明7行）を
  // 同じ営業時間の曜日をまとめたコンパクトな表示用データに変換するロジック
  // 本体は src/lib/liveHoursFormat.ts に切り出してある（ユニットテスト
  // 可能にするため。テストは src/lib/liveHoursFormat.test.ts 参照）。
  // このコンポーネント側はDOM組み立てのみを担当する。
  import { parseWeekdayDescriptions, formatHours, type FormattedHours } from '../lib/liveHoursFormat';

  interface PlaceHoursResponse {
    weekdayDescriptions?: unknown;
  }

  function renderRawFallback(list: HTMLElement, lines: string[]) {
    list.replaceChildren(
      ...lines.map((line) => {
        const p = document.createElement('p');
        p.textContent = line;
        return p;
      })
    );
  }

  function renderFormattedHours(list: HTMLElement, formatted: FormattedHours) {
    const elements: HTMLElement[] = [];

    const hoursP = document.createElement('p');
    const hoursLabel = document.createElement('span');
    hoursLabel.className = 'text-gold-100/55';
    hoursLabel.textContent = '営業時間: ';
    hoursP.append(hoursLabel, document.createTextNode(formatted.openLines[0] ?? ''));
    elements.push(hoursP);
    for (const extraLine of formatted.openLines.slice(1)) {
      const p = document.createElement('p');
      p.className = 'pl-[4.5em]'; // "営業時間: " のインデントに揃える
      p.textContent = extraLine;
      elements.push(p);
    }

    if (formatted.closedLine) {
      const closedP = document.createElement('p');
      const closedLabel = document.createElement('span');
      closedLabel.className = 'text-gold-100/55';
      closedLabel.textContent = '定休日: ';
      closedP.append(closedLabel, document.createTextNode(formatted.closedLine));
      elements.push(closedP);
    }

    list.replaceChildren(...elements);
  }

  async function renderLivePlaceHours(el: HTMLElement) {
    const placeId = el.dataset.placeId;
    if (!placeId) return;

    let data: PlaceHoursResponse;
    try {
      const res = await fetch(`/api/place-hours?placeId=${encodeURIComponent(placeId)}`);
      if (!res.ok) return;
      data = await res.json();
    } catch {
      return;
    }

    const lines = Array.isArray(data.weekdayDescriptions)
      ? data.weekdayDescriptions.filter((line): line is string => typeof line === 'string')
      : [];
    if (lines.length === 0) return;

    const list = el.querySelector<HTMLElement>('[data-live-place-hours-list]');
    if (!list) return;

    const parsed = parseWeekdayDescriptions(lines);
    if (parsed) {
      renderFormattedHours(list, formatHours(parsed));
    } else {
      // 想定外の書式（フィールド形式の変更・特殊表記等）。要約を諦め、
      // 従来通り7行そのまま表示する（誤った要約よりは安全側に倒す）。
      renderRawFallback(list, lines);
    }
    el.classList.remove('hidden');

    // 静的表示（openHours/regularHoliday）はここでのみ隠す。矛盾する情報を
    // 同時に見せないため、置き換えに成功したときだけ隠す。
    document.querySelector('[data-static-open-hours]')?.classList.add('hidden');
    document.querySelector('[data-static-regular-holiday]')?.classList.add('hidden');
  }

  function renderAll() {
    document.querySelectorAll<HTMLElement>('[data-live-place-hours]').forEach((el) => {
      void renderLivePlaceHours(el);
    });
  }

  document.addEventListener('astro:page-load', renderAll);
</script>
