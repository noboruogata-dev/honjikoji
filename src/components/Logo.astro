---
// 提供されたロゴ画像（/images/logo.png、提灯と路地の円形シンボル）を使ったロゴ。
// 画像は黒い線画のため、濃紺〜漆黒の背景にそのまま置くと沈んでしまう。
// クリーム色の丸バッジ（専用のラッパーカード）に乗せることで、暗い背景でも
// 白枠が浮かず、線画がくっきり見えるようにしている。
// 「本寺小路 / HONJIKOJI / SANJO NIGHT GUIDE」のワードマークはサイトのダークトーンに
// 直接馴染むよう、画像化せずテキストとして描画する（可読性・アクセシビリティのため）。

interface Props {
  size?: 'sm' | 'md' | 'lg';
  showTagline?: boolean;
  /** モバイルヘッダー用。円形シンボルと和文サイト名だけを表示する。 */
  compact?: boolean;
  href?: string;
  class?: string;
}

const {
  size = 'md',
  showTagline = true,
  compact = false,
  href = '/',
  class: className = '',
} = Astro.props;

const BADGE_PX: Record<string, number> = { sm: 32, md: 40, lg: 52 };
const badgePx = BADGE_PX[size];
// ヘッダー（md/lg）は小さな表示でも円形輪郭を識別しやすいよう、画像を
// バッジの内周いっぱいまで使う。フッター用のsmだけ従来の余白を残す。
const badgePaddingPx = size === 'sm' ? Math.round(badgePx * 0.12) : 0;

const TITLE_CLASS: Record<string, string> = {
  sm: 'text-base',
  md: 'text-xl',
  lg: 'text-2xl sm:text-3xl',
};

const SUB_CLASS: Record<string, string> = {
  sm: 'text-[9px]',
  md: 'text-[10px]',
  lg: 'text-[11px]',
};
---

<a href={href} class:list={['group inline-flex items-center gap-3', className]}>
  <span
    class="inline-flex shrink-0 items-center justify-center rounded-full border border-amber-deep/40 bg-gold-100 shadow-[0_0_14px_rgba(242,181,68,0.35)] transition-transform duration-300 group-hover:scale-105"
    style={`width:${badgePx}px;height:${badgePx}px;padding:${badgePaddingPx}px;`}
  >
    <img
      src="/images/logo.png"
      width="256"
      height="256"
      alt="本寺小路のシンボルマーク（提灯と路地のイラスト）"
      class="h-full w-full object-contain"
    />
  </span>

  <span class="flex flex-col leading-none">
    {
      showTagline && !compact && (
        <span class={`mb-1 tracking-[0.3em] text-amber-glow/80 ${SUB_CLASS[size]}`}>
          SANJO NIGHT GUIDE
        </span>
      )
    }
    <span class:list={['font-serif font-bold text-gold-100 text-glow', TITLE_CLASS[size]]}>
      本寺小路
    </span>
    {
      !compact && (
        <span class={`mt-1 tracking-[0.15em] text-gold-100/45 ${SUB_CLASS[size]}`}>
          {showTagline ? (
            'HONJIKOJI'
          ) : (
            <>
              HONJIKOJI <span class="text-vermilion/70">|</span> SANJO NIGHT GUIDE
            </>
          )}
        </span>
      )
    }
  </span>
</a>
