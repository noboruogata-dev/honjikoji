---
// 提灯（ちょうちん）モチーフのSVGロゴ + 「本寺小路 HONJIKOJI | SANJO NIGHT GUIDE」ワードマーク。
// 画像ファイルを使わず、SVGとグラデーションのみで構築。

interface Props {
  size?: 'sm' | 'md' | 'lg';
  showTagline?: boolean;
  href?: string;
  class?: string;
}

const { size = 'md', showTagline = true, href = '/', class: className = '' } = Astro.props;

// ヘッダー/フッターなど同一ページ内で複数回使われてもgradient idが衝突しないように。
const uid = Math.random().toString(36).slice(2, 9);

const ICON_PX: Record<string, number> = { sm: 28, md: 36, lg: 46 };
const iconPx = ICON_PX[size];

const TITLE_CLASS: Record<string, string> = {
  sm: 'text-base',
  md: 'text-xl',
  lg: 'text-2xl sm:text-3xl',
};

const SUB_CLASS: Record<string, string> = {
  sm: 'text-[9px]',
  md: 'text-[10px]',
  lg: 'text-[11px]',
};
---

<a href={href} class:list={['group inline-flex items-center gap-3', className]}>
  <svg
    width={iconPx}
    height={iconPx * 1.375}
    viewBox="0 0 32 44"
    fill="none"
    class="lantern-flicker shrink-0 drop-shadow-[0_0_10px_rgba(242,181,68,0.45)] transition-transform duration-300 group-hover:scale-105"
    aria-hidden="true"
  >
    <defs>
      <radialGradient id={`lantern-body-${uid}`} cx="50%" cy="38%" r="65%">
        <stop offset="0%" stop-color="var(--color-amber-glow)" />
        <stop offset="55%" stop-color="var(--color-amber-deep)" />
        <stop offset="100%" stop-color="var(--color-vermilion)" />
      </radialGradient>
      <linearGradient id={`lantern-cap-${uid}`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--color-vermilion)" />
        <stop offset="100%" stop-color="var(--color-vermilion-deep)" />
      </linearGradient>
    </defs>

    <!-- 吊り紐 -->
    <line x1="16" y1="0" x2="16" y2="3" stroke="var(--color-night-500)" stroke-width="1" />
    <!-- 上部の輪 -->
    <rect x="13" y="2.5" width="6" height="2.5" rx="1.25" fill="var(--color-night-600)" />

    <!-- 上キャップ -->
    <path d="M7 6 L25 6 L21.5 9.5 L10.5 9.5 Z" fill={`url(#lantern-cap-${uid})`} />

    <!-- 提灯本体 -->
    <path
      d="M9 9.5 C4 15 4 29 9 34.5 L23 34.5 C28 29 28 15 23 9.5 Z"
      fill={`url(#lantern-body-${uid})`}
      stroke="var(--color-night-950)"
      stroke-width="0.75"
      stroke-opacity="0.35"
    />

    <!-- 骨（横線） -->
    <path d="M5.5 14 H26.5" stroke="var(--color-night-950)" stroke-width="0.6" stroke-opacity="0.3" />
    <path d="M4.3 20 H27.7" stroke="var(--color-night-950)" stroke-width="0.6" stroke-opacity="0.3" />
    <path d="M5.5 26 H26.5" stroke="var(--color-night-950)" stroke-width="0.6" stroke-opacity="0.3" />

    <!-- 文字（本） -->
    <text
      x="16"
      y="23.5"
      text-anchor="middle"
      font-size="8"
      font-weight="700"
      fill="var(--color-night-950)"
      fill-opacity="0.55"
      font-family="serif">本</text
    >

    <!-- 下キャップ -->
    <path d="M10.5 34.5 L21.5 34.5 L25 38 L7 38 Z" fill={`url(#lantern-cap-${uid})`} />

    <!-- 房（タッセル） -->
    <line x1="16" y1="38" x2="16" y2="42" stroke="var(--color-night-500)" stroke-width="1" />
    <circle cx="16" cy="43" r="1.4" fill="var(--color-amber-glow)" />
  </svg>

  <span class="flex flex-col leading-none">
    {
      showTagline && (
        <span class={`mb-1 tracking-[0.3em] text-amber-glow/80 ${SUB_CLASS[size]}`}>
          SANJO NIGHT GUIDE
        </span>
      )
    }
    <span class:list={['font-serif font-bold text-gold-100 text-glow', TITLE_CLASS[size]]}>
      本寺小路
    </span>
    <span class={`mt-1 tracking-[0.15em] text-gold-100/45 ${SUB_CLASS[size]}`}>
      {
        showTagline ? (
          'HONJIKOJI'
        ) : (
          <>
            HONJIKOJI <span class="text-vermilion/70">|</span> SANJO NIGHT GUIDE
          </>
        )
      }
    </span>
  </span>
</a>
