---
import {
  Beef,
  ChefHat,
  CookingPot,
  Flame,
  GlassWater,
  Martini,
  MicVocal,
  Soup,
  Store,
  UtensilsCrossed,
} from '@lucide/astro';
import Illust from './Illust.astro';
import { GENRE_ICON_MAP } from '../lib/genreIcons';

interface Props {
  genre: string;
  size?: number;
  class?: string;
  strokeWidth?: number;
}

const { genre, size = 18, class: className = '', strokeWidth = 1.75 } = Astro.props;

// PNG化されているジャンルはIllust(mode="mask")で表示。それ以外は従来通り
// Lucideアイコンにフォールバック（未知のジャンルは Store）。
const pngSrc = GENRE_ICON_MAP[genre];

const ICON_MAP: Record<string, typeof Store> = {
  居酒屋: UtensilsCrossed,
  焼肉: Beef,
  ラーメン: Soup,
  BAR: Martini,
  Bar: Martini,
  バー: Martini,
  スナック: MicVocal,
  割烹: ChefHat,
  小料理: ChefHat,
  小料理屋: ChefHat,
  焼き鳥: Flame,
  焼鳥: Flame,
  おでん: CookingPot,
  立ち飲み: GlassWater,
  立ち呑み: GlassWater,
};

const Icon = ICON_MAP[genre] ?? Store;
---

{
  pngSrc ? (
    <Illust src={pngSrc} mode="mask" size={size} alt="" class={className} />
  ) : (
    <Icon size={size} stroke-width={strokeWidth} class={className} aria-hidden="true" />
  )
}
