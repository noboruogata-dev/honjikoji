---
// ニュース一覧の1件。スマホでは日付・分類とタイトルを2段で見せる。
import { BookOpenText, MapPin } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';
import EventStatus from './EventStatus.astro';

interface Props {
  item: CollectionEntry<'news'>;
}

const { item } = Astro.props;

const CATEGORY_ACCENT: Record<string, 'amber' | 'vermilion'> = {
  'NEW SPOT': 'vermilion',
  EVENT: 'amber',
  NOTICE: 'amber',
};

const accent = CATEGORY_ACCENT[item.data.category] ?? 'amber';
const relatedSpotSlug = item.data.relatedSpotSlug;
const relatedColumnSlug = item.data.relatedColumnSlug;
const dateStr = item.data.pubDate.toISOString().slice(0, 10);
const href = `/news/${item.id}/`;
---

<li
  class:list={[
    'flex items-center gap-3 border-l-2 px-4 py-2 transition-colors',
    accent === 'vermilion' ? 'border-l-vermilion/40 hover:bg-vermilion/[0.03]' : 'border-l-amber-glow/40 hover:bg-amber-glow/[0.03]',
  ]}
>
  <a href={href} class="block min-h-11 min-w-0 flex-1 py-1 underline-offset-4 transition hover:underline focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-glow sm:flex sm:items-center sm:gap-3">
    <span class="flex items-center gap-2.5 sm:shrink-0">
      <time class="shrink-0 text-xs tabular-nums text-gold-100/60" datetime={dateStr}>
        {dateStr}
      </time>
      <span
        class:list={[
          'inline-flex shrink-0 items-center rounded-full px-2 py-0.5 text-[0.65rem] font-semibold',
          accent === 'vermilion' ? 'bg-vermilion/15 text-vermilion' : 'bg-amber-glow/15 text-amber-glow',
        ]}
      >
        {item.data.category}
      </span>
      {item.data.eventEndDate && <EventStatus endDate={item.data.eventEndDate} />}
    </span>
    <span class="mt-1 block line-clamp-2 text-sm font-medium leading-6 text-gold-100 transition hover:text-amber-glow sm:mt-0 sm:line-clamp-1">
      {item.data.title}
    </span>
  </a>
  {
    relatedSpotSlug && (
      <a
        href={`/spots/${relatedSpotSlug}/`}
        class="hidden shrink-0 items-center gap-1 rounded-full border border-night-600 px-2 py-1 text-[0.6rem] text-gold-100/50 transition hover:border-amber-deep/60 hover:text-amber-glow sm:inline-flex"
      >
        <MapPin size={10} stroke-width={2} aria-hidden="true" />
        店舗
      </a>
    )
  }
  {
    relatedColumnSlug && (
      <a
        href={`/columns/${relatedColumnSlug}/`}
        class="hidden shrink-0 items-center gap-1 rounded-full border border-night-600 px-2 py-1 text-[0.6rem] text-gold-100/50 transition hover:border-amber-deep/60 hover:text-amber-glow sm:inline-flex"
      >
        <BookOpenText size={10} stroke-width={2} aria-hidden="true" />
        夜話
      </a>
    )
  }
</li>
