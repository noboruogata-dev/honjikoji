---
// ニュース一覧の1行。index.astro（トップの「お知らせ」プレビュー）と
// news/index.astro（ニュース一覧本体）の両方から使う共通コンポーネント
// （元々は2箇所に同じマークアップが複製されていて、片方だけ直して
// 片方が古いままになる不具合の原因になっていた）。
import { ArrowRight, BookOpenText, MapPin } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  item: CollectionEntry<'news'>;
}

const { item } = Astro.props;

const CATEGORY_ACCENT: Record<string, 'amber' | 'vermilion'> = {
  'NEW SPOT': 'vermilion',
  EVENT: 'amber',
  NOTICE: 'amber',
};

const accent = CATEGORY_ACCENT[item.data.category] ?? 'amber';
const relatedSpotSlug = item.data.relatedSpotSlug;
const relatedColumnSlug = item.data.relatedColumnSlug;
const dateStr = item.data.pubDate.toISOString().slice(0, 10);
const href = `/news/${item.id}/`;
---

<li
  class:list={[
    'flex items-center gap-2.5 border-l-2 px-4 py-3 transition-colors sm:gap-3',
    accent === 'vermilion' ? 'border-l-vermilion/40 hover:bg-vermilion/[0.03]' : 'border-l-amber-glow/40 hover:bg-amber-glow/[0.03]',
  ]}
>
  <time class="hidden shrink-0 text-xs tabular-nums text-gold-100/35 sm:block" datetime={dateStr}>
    {dateStr}
  </time>
  <span
    class:list={[
      'shrink-0 inline-flex items-center rounded-full px-2 py-0.5 text-[0.6rem] font-semibold',
      accent === 'vermilion' ? 'bg-vermilion/15 text-vermilion' : 'bg-amber-glow/15 text-amber-glow',
    ]}
  >
    {item.data.category}
  </span>
  <a href={href} class="min-w-0 flex-1 truncate text-sm font-medium text-gold-100 underline-offset-4 transition hover:text-amber-glow hover:underline">
    {item.data.title}
  </a>
  {
    relatedSpotSlug && (
      <a
        href={`/spots/${relatedSpotSlug}/`}
        class="hidden shrink-0 items-center gap-1 rounded-full border border-night-600 px-2 py-1 text-[0.6rem] text-gold-100/50 transition hover:border-amber-deep/60 hover:text-amber-glow sm:inline-flex"
      >
        <MapPin size={10} stroke-width={2} aria-hidden="true" />
        店舗
      </a>
    )
  }
  {
    relatedColumnSlug && (
      <a
        href={`/columns/${relatedColumnSlug}/`}
        class="hidden shrink-0 items-center gap-1 rounded-full border border-night-600 px-2 py-1 text-[0.6rem] text-gold-100/50 transition hover:border-amber-deep/60 hover:text-amber-glow sm:inline-flex"
      >
        <BookOpenText size={10} stroke-width={2} aria-hidden="true" />
        夜話
      </a>
    )
  }
  <a
    href={href}
    class="inline-flex shrink-0 items-center gap-1 rounded-full bg-night-800 px-2.5 py-1 text-[0.65rem] font-semibold text-amber-glow/90 transition hover:bg-amber-glow hover:text-night-950"
  >
    読む
    <ArrowRight size={10} stroke-width={2.5} aria-hidden="true" />
  </a>
</li>
