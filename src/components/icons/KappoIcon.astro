---
// 「割烹」向けの自前アイコン（出刃包丁）。GenreIcon.astroのICON_MAPから
// Lucideアイコンと同じ形（size・stroke-width・class props）で使う。
// PNG化された他ジャンルのアイコン（icon-tokkuri.png等）はIllust
// mode="mask"でアルファだけを使い currentColor で塗って表示するため、
// 色の情報は表示に一切反映されない（見た目は単色シルエット）。
// このアイコンも同じ土俵に立つよう、Lucideと同じ「線画・currentColor」の
// 見た目に揃えている（色付きイラストとして描く必要が無い）。
interface Props {
  size?: number;
  class?: string;
  'stroke-width'?: number;
}

const { size = 24, class: className = '', 'stroke-width': strokeWidth = 1.75 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <path d="M3 15.5 15.5 4a2 2 0 0 1 3 2.7L8 19" />
  <path d="M8 19H3.8a.8.8 0 0 1-.6-1.3L6 14.3" />
  <path d="m13.5 6 3.2 3.2" />
</svg>
