---
import { Navigation } from '@lucide/astro';

interface Props {
  title: string;
  query: string;
}

const { title, query } = Astro.props;

// Googleマップの写真・地図タイルは一切スクレイピング/直リンクせず、
// Google公式のiframe埋め込み（output=embed）と検索リンクのみを利用する。
// APIキー不要のクラシックな埋め込み方式で、店舗の正確な緯度経度が
// 分からなくても「店名 + 住所」の検索クエリから合法的に表示できる。
const embedSrc = `https://www.google.com/maps?q=${encodeURIComponent(query)}&output=embed`;
const externalUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
---

<section aria-labelledby="map-heading" class="mt-10">
  <h2 id="map-heading" class="mb-3 font-serif text-xl font-bold text-gold-100">
    地図・アクセス
  </h2>

  <div class="overflow-hidden rounded-xl border border-night-700 bg-night-900">
    <div class="aspect-[4/3] w-full sm:aspect-video">
      <iframe
        title={`${title}の地図（Google マップ）`}
        src={embedSrc}
        width="100%"
        height="100%"
        style="border:0;"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="grayscale-[15%] contrast-[1.05]"
      ></iframe>
    </div>

    <div class="flex items-center justify-between gap-3 border-t border-night-700 bg-night-800/60 px-4 py-3">
      <p class="text-xs text-gold-100/40">地図データ &copy; Google</p>
      <a
        href={externalUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-amber-glow px-3.5 py-1.5 text-xs font-semibold text-night-950 transition hover:brightness-110"
      >
        <Navigation size={14} stroke-width={2.25} aria-hidden="true" />
        Googleマップで経路・口コミを見る
      </a>
    </div>
  </div>
</section>
