---
// 検索結果0件などの「何も無い」状態を表す共通コンポーネント。
// data-empty-message は一覧ページのfilterスクリプトが hidden をトグルする対象。
import Illust from './Illust.astro';

interface Props {
  message?: string;
  class?: string;
}

const { message = '条件に合う店舗が見つかりませんでした。', class: className = '' } = Astro.props;
---

<div class:list={['py-16 text-center', className]} data-empty-message>
  <Illust
    src="/images/states/empty.png"
    mode="tint"
    size={160}
    glow
    alt="戸を閉じた店先に提灯がひとつ下がる、何もない路地の情景"
    class="mx-auto"
  />
  <p class="mt-4 text-sm text-gold-100/40">{message}</p>
</div>
