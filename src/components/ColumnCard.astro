---
// コラム（本寺小路夜話）のカード。columns/index.astro（一覧本体）と
// index.astro（トップの「本寺小路夜話」プレビュー）の両方から使う共通
// コンポーネント（元々は2箇所にほぼ同じマークアップが複製されていた）。
//
// ヘッダー行（アイコン+カテゴリ名+日付）はSpotCard.astroのジャンル
// ヘッダーと同じ構図に揃えてあり、店舗カード・コラムカードのどちらを
// 見ても同じ「アイコン付きヘッダー→タイトル→本文→CTA」の順で読めるようにする。
import { ArrowRight, GlassWater, Landmark, Moon, Users } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  column: CollectionEntry<'columns'>;
}

const { column } = Astro.props;

const CATEGORY_ICON: Record<string, typeof GlassWater> = {
  'お酒の豆知識': GlassWater,
  '街の歴史': Landmark,
  '店と人': Users,
  '夜の作法': Moon,
};

const Icon = CATEGORY_ICON[column.data.category] ?? GlassWater;
const image = column.data.imageStatus === 'reviewed' || column.data.imageStatus === 'qa-passed' ? column.data.eyecatch : undefined;
const dateStr = column.data.pubDate.toISOString().slice(0, 10);
---

<a
  href={`/columns/${column.id}/`}
  class="group flex flex-col overflow-hidden rounded-2xl border border-gold-100/15 bg-gold-100/[0.025] transition hover:-translate-y-0.5 hover:border-amber-glow/35 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-glow"
>
  {image && <img src={image.src} alt="" width="1200" height="630" loading="lazy" decoding="async" class="aspect-[1200/630] w-full object-cover" />}
  <div class="flex items-center gap-1.5 border-b border-night-700 bg-night-800/50 px-4 py-3 text-xs font-medium tracking-wide text-amber-glow">
    <Icon size={14} stroke-width={1.75} aria-hidden="true" />
    {column.data.category}
    <time class="ml-auto shrink-0 text-gold-100/35" datetime={dateStr}>{dateStr}</time>
  </div>
  <div class="flex flex-1 flex-col gap-2 p-5">
    <h3 class="font-serif text-lg font-bold leading-relaxed text-gold-100 transition group-hover:text-amber-glow">{column.data.title}</h3>
    <p class="line-clamp-3 text-sm leading-[1.8] text-gold-100/60">{column.data.summary}</p>
    <span class="mt-auto inline-flex items-center gap-1 pt-2 text-xs text-amber-glow group-hover:underline group-hover:underline-offset-4">
      続きを読む
      <ArrowRight class="transition-transform group-hover:translate-x-0.5 motion-reduce:transform-none" size={12} aria-hidden="true" />
    </span>
  </div>
</a>
