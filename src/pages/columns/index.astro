---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { ArrowRight, BookOpenText } from '@lucide/astro';
import { getCollection } from 'astro:content';

const categories = ['お酒の豆知識', '街の歴史', '店と人', '夜の作法'];
const columns = (await getCollection('columns', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<Layout title="本寺小路夜話｜本寺小路ガイド" description="酒の豆知識、街の歴史、店と人、夜の作法。本寺小路を深く味わうためのコラム『本寺小路夜話』。">
  <Header />
  <main class="mx-auto max-w-5xl px-4 py-12 sm:py-16">
    <section class="relative overflow-hidden rounded-2xl border border-night-700 bg-night-900/60 px-6 py-12 text-center sm:px-12 sm:py-16">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_65%_55%_at_50%_0%,var(--glow),transparent),radial-gradient(ellipse_35%_45%_at_100%_100%,rgba(200,65,47,0.10),transparent)]" aria-hidden="true"></div>
      <div class="relative">
        <span class="mx-auto inline-flex h-12 w-12 items-center justify-center rounded-full border border-amber-glow/35 text-amber-glow shadow-[0_0_22px_var(--glow)]" aria-hidden="true"><BookOpenText size={23} stroke-width={1.5} /></span>
        <p class="mt-5 text-xs tracking-[0.3em] text-amber-glow/70">HONJIKOJI YOBANASHI</p>
        <h1 class="mt-2 font-serif text-3xl font-bold tracking-[0.04em] text-gold-100 text-glow sm:text-4xl">本寺小路夜話</h1>
        <p class="mx-auto mt-6 max-w-[34em] whitespace-pre-line leading-[1.9] text-gold-100/70">酒のこと、街の記憶、店に立つ人、夜の歩き方。
本寺小路をもう少し深く味わうための、夜の読みものです。</p>
        <ul class="mx-auto mt-8 grid max-w-2xl grid-cols-2 gap-3 sm:grid-cols-4">
          {categories.map((category) => <li class="rounded-lg border border-gold-100/15 bg-gold-100/[0.025] px-3 py-3 text-sm text-gold-100/75">{category}</li>)}
        </ul>
      </div>
    </section>

    {columns.length > 0 ? (
      <section class="mt-12" aria-labelledby="column-list-heading">
        <h2 id="column-list-heading" class="font-serif text-2xl font-bold text-gold-100">夜話を読む</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          {columns.map((column) => {
            const image = column.data.imageStatus === 'reviewed' || column.data.imageStatus === 'qa-passed' ? column.data.eyecatch : undefined;
            return (
              <article class="group overflow-hidden rounded-2xl border border-gold-100/15 bg-gold-100/[0.025] transition hover:border-amber-glow/35">
                {image && <a href={`/columns/${column.id}/`} tabindex="-1" aria-hidden="true"><img src={image.src} alt="" width="1200" height="630" loading="lazy" decoding="async" class="aspect-[1200/630] w-full object-cover" /></a>}
                <div class="p-5 sm:p-6">
                  <div class="flex items-center gap-3 text-xs"><span class="text-amber-glow">{column.data.category}</span><time class="text-gold-100/40" datetime={column.data.pubDate.toISOString().slice(0, 10)}>{column.data.pubDate.toISOString().slice(0, 10)}</time></div>
                  <h3 class="mt-3 font-serif text-xl font-bold leading-relaxed text-gold-100"><a href={`/columns/${column.id}/`} class="transition group-hover:text-amber-glow">{column.data.title}</a></h3>
                  <p class="mt-3 line-clamp-3 text-sm leading-[1.8] text-gold-100/65">{column.data.summary}</p>
                  <a href={`/columns/${column.id}/`} class="mt-5 inline-flex items-center gap-1 text-sm text-amber-glow hover:underline hover:underline-offset-4">続きを読む <ArrowRight size={14} aria-hidden="true" /></a>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    ) : (
      <section class="mt-12 rounded-2xl border border-gold-100/15 bg-gold-100/[0.025] px-6 py-10 text-center">
        <p class="font-serif text-lg text-gold-100/80">ただいま、最初の夜話を支度しています。</p>
        <a href="/about/" class="mt-5 inline-flex items-center gap-2 text-sm text-amber-glow hover:underline hover:underline-offset-4">本寺小路の歴史を読む <ArrowRight size={14} aria-hidden="true" /></a>
      </section>
    )}
  </main>
  <Footer />
</Layout>
