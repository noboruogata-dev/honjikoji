---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SpotCard from '../components/SpotCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import AlleyNight from '../components/illustrations/AlleyNight.astro';
import { getCollection } from 'astro:content';
import { ArrowRight, Landmark, MapPin, Megaphone } from '@lucide/astro';

const spots = (await getCollection('spots')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const genres = [...new Set(spots.map((spot) => spot.data.genre))].sort();

const scenes = [
  { label: '1軒目', value: '1軒目におすすめ' },
  { label: '2次会・締め', value: '2次会・締めに最適' },
  { label: '深夜営業', value: '深夜営業' },
];

// お知らせ・更新情報。src/content/news/ から新しい順に取得（`npm run generate:news` で自動生成も可能）。
const news = (await getCollection('news'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const CATEGORY_ACCENT: Record<string, 'amber' | 'vermilion'> = {
  'NEW SPOT': 'vermilion',
  EVENT: 'amber',
  NOTICE: 'amber',
};
---

<Layout title="本寺小路ガイド｜三条市の歓楽街 飲食店・店舗ガイド">
  <Header />

  <main class="mx-auto max-w-5xl px-4 py-10">
    <!-- Hero -->
    <section class="relative mb-14 overflow-hidden rounded-2xl border border-night-700 bg-night-900/60">
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_70%_60%_at_15%_0%,rgba(242,181,68,0.14),transparent),radial-gradient(ellipse_55%_55%_at_100%_5%,rgba(226,71,47,0.12),transparent)]"
      >
      </div>

      <div class="relative grid grid-cols-1 items-center gap-8 px-5 py-10 sm:grid-cols-2 sm:gap-10 sm:px-10 sm:py-14">
        <div class="order-2 text-center sm:order-1 sm:text-left">
          <h2 class="font-serif text-2xl font-bold leading-snug text-gold-100 text-glow sm:text-3xl">
            灯りともる路地で、今夜の一軒を。
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-gold-100/65 sm:text-base">
            新潟県三条市の歓楽街「本寺小路」。鍛冶職人の町が育んだ、一見さんも常連も分け隔てない大人の社交街へようこそ。
          </p>
          <a
            href="#spots"
            class="mt-5 inline-flex items-center gap-1.5 rounded-full bg-amber-glow px-5 py-2.5 text-sm font-semibold text-night-950 transition hover:brightness-110"
          >
            店舗を探す
            <ArrowRight size={16} stroke-width={2.25} aria-hidden="true" />
          </a>
        </div>

        <div class="order-1 sm:order-2">
          <div
            class="relative overflow-hidden rounded-2xl border border-night-700/60 bg-gradient-to-br from-night-800/50 to-transparent p-4 sm:p-6"
          >
            <div
              class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_60%_60%_at_30%_20%,rgba(242,181,68,0.14),transparent)]"
            >
            </div>
            <img
              src="/images/keyvisual.png"
              width="804"
              height="702"
              alt="赤提灯と「本寺小路」ののれんが灯る路地の様子。居酒屋やスナックの看板が並び、行き交う人影が見える夜の情景。"
              class="relative mx-auto w-full max-w-sm object-contain drop-shadow-[0_0_32px_rgba(242,181,68,0.3)] sm:max-w-none"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- News / Updates -->
    <section class="mb-14" aria-labelledby="news-heading">
      <div id="news-heading">
        <SectionHeading icon={Megaphone} label="NEWS" accent="vermilion">お知らせ</SectionHeading>
      </div>

      {
        news.length > 0 ? (
          <ul class="mt-5 divide-y divide-night-700 overflow-hidden rounded-xl border border-night-700 bg-night-900/50">
            {news.map((item) => {
              const accent = CATEGORY_ACCENT[item.data.category] ?? 'amber';
              const relatedSpotSlug = item.data.relatedSpotSlug;
              const dateStr = item.data.pubDate.toISOString().slice(0, 10);
              const href = `/news/${item.id}/`;
              return (
                <li class="flex items-center gap-2.5 px-4 py-3 sm:gap-3">
                  <time class="hidden shrink-0 text-xs tabular-nums text-gold-100/35 sm:block" datetime={dateStr}>
                    {dateStr}
                  </time>
                  <span
                    class:list={[
                      'shrink-0 inline-flex items-center rounded-full px-2 py-0.5 text-[0.6rem] font-semibold',
                      accent === 'vermilion' ? 'bg-vermilion/15 text-vermilion' : 'bg-amber-glow/15 text-amber-glow',
                    ]}
                  >
                    {item.data.category}
                  </span>
                  <a
                    href={href}
                    class="min-w-0 flex-1 truncate text-sm font-medium text-gold-100 underline-offset-4 transition hover:text-amber-glow hover:underline"
                  >
                    {item.data.title}
                  </a>
                  {relatedSpotSlug && (
                    <a
                      href={`/spots/${relatedSpotSlug}/`}
                      class="hidden shrink-0 items-center gap-1 rounded-full border border-night-600 px-2 py-1 text-[0.6rem] text-gold-100/50 transition hover:border-amber-deep/60 hover:text-amber-glow sm:inline-flex"
                    >
                      <MapPin size={10} stroke-width={2} aria-hidden="true" />
                      店舗
                    </a>
                  )}
                  <a
                    href={href}
                    class="inline-flex shrink-0 items-center gap-1 rounded-full bg-night-800 px-2.5 py-1 text-[0.65rem] font-semibold text-amber-glow/90 transition hover:bg-amber-glow hover:text-night-950"
                  >
                    読む
                    <ArrowRight size={10} stroke-width={2.5} aria-hidden="true" />
                  </a>
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="mt-5 rounded-xl border border-night-700 bg-night-900/50 px-4 py-6 text-center text-sm text-gold-100/40">
            現在お知らせはありません。
          </p>
        )
      }
    </section>

    <!-- 特集バナー: 本寺小路とは -->
    <section class="mb-14 overflow-hidden rounded-2xl border border-night-700 bg-night-900/60">
      <div class="grid grid-cols-1 sm:grid-cols-5">
        <div class="relative h-40 overflow-hidden sm:col-span-2 sm:h-auto">
          <AlleyNight class="absolute inset-0 h-full w-full opacity-25" />
          <div
            class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgba(8,9,15,0),rgba(8,9,15,0.85))] sm:bg-[linear-gradient(90deg,rgba(8,9,15,0),rgba(8,9,15,0.9))]"
          >
          </div>
          <div class="relative flex h-full items-end p-5 sm:items-center">
            <p class="font-serif text-xl font-bold text-gold-100 text-glow sm:text-2xl">
              本寺小路とは
            </p>
          </div>
        </div>

        <div class="p-5 sm:col-span-3 sm:p-8">
          <SectionHeading icon={Landmark} label="FEATURE" accent="amber">
            鍛冶職人の町が育んだ、夜の文化
          </SectionHeading>
          <p class="mt-4 leading-loose text-gold-100/70">
            三条は古くから鍛冶職人の技で知られる「ものづくりの町」。商談に訪れる商人や職人たちが一杯かわす社交場として、本寺小路は生まれました。昭和には料亭やスナックが軒を連ねる最盛期を迎え、令和の今も「一見さんとも常連ともなく、みんなが顔なじみになっていく」独特の距離感を受け継いでいます。
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href="/about/#roots"
              class="inline-flex items-center gap-1.5 rounded-full bg-amber-glow px-4 py-2 text-xs font-semibold text-night-950 transition hover:brightness-110 sm:text-sm"
            >
              鍛冶職人の町が育んだ夜の文化
              <ArrowRight size={14} stroke-width={2.25} aria-hidden="true" />
            </a>
            <a
              href="/about/#hashigo"
              class="inline-flex items-center gap-1.5 rounded-full border border-vermilion/50 bg-vermilion/10 px-4 py-2 text-xs font-semibold text-vermilion transition hover:bg-vermilion/20 sm:text-sm"
            >
              ハシゴ酒の心得を見る
              <ArrowRight size={14} stroke-width={2.25} aria-hidden="true" />
            </a>
          </div>
          <a href="/about/" class="mt-4 inline-flex items-center gap-1 text-xs text-gold-100/50 transition hover:text-amber-glow">
            本寺小路について詳しく読む
            <ArrowRight size={12} stroke-width={2.25} aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>

    <!-- Spots -->
    <section id="spots" class="scroll-mt-8" aria-labelledby="spots-heading">
      <div id="spots-heading">
        <SectionHeading icon={MapPin} label="SPOTS" accent="amber">店舗一覧</SectionHeading>
      </div>

      <div class="mt-6 space-y-3">
        <div>
          <p class="mb-2 text-xs font-medium tracking-wide text-gold-100/40">ジャンルで絞り込み</p>
          <div class="flex flex-wrap gap-2" data-filter-group="genre">
            <button
              type="button"
              data-value="all"
              aria-pressed="true"
              class="filter-btn rounded-full border border-amber-deep bg-amber-glow px-3.5 py-1.5 text-xs font-semibold text-night-950 transition"
            >
              すべて
            </button>
            {
              genres.map((genre) => (
                <button
                  type="button"
                  data-value={genre}
                  aria-pressed="false"
                  class="filter-btn rounded-full border border-night-600 bg-night-800/60 px-3.5 py-1.5 text-xs font-medium text-gold-100/70 transition hover:border-amber-deep/60 hover:text-amber-glow"
                >
                  {genre}
                </button>
              ))
            }
          </div>
        </div>

        <div>
          <p class="mb-2 text-xs font-medium tracking-wide text-gold-100/40">シーンで絞り込み</p>
          <div class="flex flex-wrap gap-2" data-filter-group="scene">
            <button
              type="button"
              data-value="all"
              aria-pressed="true"
              class="filter-btn rounded-full border border-amber-deep bg-amber-glow px-3.5 py-1.5 text-xs font-semibold text-night-950 transition"
            >
              すべて
            </button>
            {
              scenes.map((scene) => (
                <button
                  type="button"
                  data-value={scene.value}
                  aria-pressed="false"
                  class="filter-btn rounded-full border border-night-600 bg-night-800/60 px-3.5 py-1.5 text-xs font-medium text-gold-100/70 transition hover:border-amber-deep/60 hover:text-amber-glow"
                >
                  {scene.label}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <div class="mt-6 flex items-baseline justify-between">
        <p class="text-xs text-gold-100/40" data-result-count>{spots.length}件</p>
      </div>

      <div class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" data-spot-grid>
        {spots.map((spot) => <SpotCard spot={spot} />)}
      </div>

      <p class="hidden py-16 text-center text-sm text-gold-100/40" data-empty-message>
        条件に合う店舗が見つかりませんでした。
      </p>
    </section>

    <!-- Culture Column: 小路の歩き方 -->
    <section class="mt-16 overflow-hidden rounded-2xl border border-night-700 bg-night-900/60">
      <div class="relative">
        <div
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_60%_70%_at_50%_20%,rgba(242,181,68,0.10),transparent)]"
        >
        </div>
        <img
          src="/images/hasigozake.png"
          width="1330"
          height="523"
          alt="1軒目、2軒目、3杯目と暖簾をハシゴして本寺小路の門へ向かう、盃を手にしたイラスト"
          class="relative mx-auto w-full max-w-2xl object-contain drop-shadow-[0_0_28px_rgba(242,181,68,0.25)] sm:max-w-3xl"
          loading="lazy"
        />
      </div>
      <div class="px-6 pb-8 pt-2 text-center sm:px-10 sm:pb-10">
        <p class="text-xs tracking-[0.3em] text-amber-glow/70">CULTURE COLUMN</p>
        <h2 class="mt-2 font-serif text-xl font-bold text-gold-100 sm:text-2xl">
          1軒目・2軒目・締め、ハシゴ酒のカルチャー
        </h2>
        <p class="mx-auto mt-3 max-w-2xl leading-loose text-gold-100/65">
          居酒屋で軽く始め、BARやスナックでじっくり語らい、ラーメンやおでんで締めくくる——本寺小路には、路地一本でハシゴが完結する独特の密度があります。初めての方も、その日の気分で自由に組み立ててみてください。
        </p>
        <a
          href="/about/#hashigo"
          class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-amber-glow transition hover:text-amber-deep"
        >
          ハシゴ酒の心得を読む
          <ArrowRight size={15} stroke-width={2.25} aria-hidden="true" />
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .filter-btn[aria-pressed='true'] {
    border-color: var(--color-amber-deep);
    background-color: var(--color-amber-glow);
    color: var(--color-night-950);
  }
</style>

<script>
  const state: { genre: string; scene: string } = { genre: 'all', scene: 'all' };

  const groups = document.querySelectorAll<HTMLElement>('[data-filter-group]');
  const cards = document.querySelectorAll<HTMLElement>('[data-spot-card]');
  const resultCount = document.querySelector<HTMLElement>('[data-result-count]');
  const emptyMessage = document.querySelector<HTMLElement>('[data-empty-message]');

  function applyFilters() {
    let visible = 0;
    cards.forEach((card) => {
      const genre = card.dataset.genre ?? '';
      const vibes = (card.dataset.vibes ?? '').split('|');

      const genreMatch = state.genre === 'all' || genre === state.genre;
      const sceneMatch = state.scene === 'all' || vibes.includes(state.scene);
      const show = genreMatch && sceneMatch;

      card.classList.toggle('hidden', !show);
      if (show) visible += 1;
    });

    if (resultCount) resultCount.textContent = `${visible}件`;
    if (emptyMessage) emptyMessage.classList.toggle('hidden', visible !== 0);
  }

  groups.forEach((group) => {
    const groupName = group.dataset.filterGroup as 'genre' | 'scene';
    const buttons = group.querySelectorAll<HTMLButtonElement>('.filter-btn');

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        buttons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
        button.setAttribute('aria-pressed', 'true');
        state[groupName] = button.dataset.value ?? 'all';
        applyFilters();
      });
    });
  });
</script>
