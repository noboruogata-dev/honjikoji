---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SpotCard from '../components/SpotCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ColumnCard from '../components/ColumnCard.astro';
import LanternIcon from '../components/illustrations/LanternIcon.astro';
import AlleyNight from '../components/illustrations/AlleyNight.astro';
import RuleDivider from '../components/RuleDivider.astro';
import StructuredData from '../components/StructuredData.astro';
import { getCollection } from 'astro:content';
import { ArrowRight, MapPin } from '@lucide/astro';

// 新着店舗: isNewを優先し、次点でpubDate降順。先頭6件のみトップに出す
// （全件・フィルタ付きの一覧は /spots/ へ移設済み）。Hero内の「何軒中何軒が
// 営業中」表示は掲載店"全件"を対象にするため、slice前の全件を別途保持する。
const allSpots = await getCollection('spots');
const featuredSpots = [...allSpots]
  .sort((a, b) => {
    if (a.data.isNew !== b.data.isNew) return a.data.isNew ? -1 : 1;
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  })
  .slice(0, 6);

// お知らせ・更新情報。夜話の公開通知は直後の専用セクションと重複するため
// トップでは除外し、ニュース一覧には残す。ここでは最新3件に絞る。
const news = (await getCollection('news'))
  .filter((item) => !item.data.relatedColumnSlug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const columns = (await getCollection('columns', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// Heroパララックスの手前を流れる提灯。描画負荷を抑えるため6個までに固定。
// 「下から上へ大きく流れる」動きにするため、各提灯は
// 0%: 画面下からvhStart分だけ下の位置・縮小・不透明度0（未到達）
// 50%: 中央（translateY:0）・peakScaleまで拡大・完全点灯
// 100%: 画面上へvhEnd分だけ抜けた位置・縮小・不透明度0（通過済み）
// という3段の共通keyframe（<style>のhero-lantern-stream）を、インスタンスごとに
// CSS変数（vhStart/vhEnd/peakScale）とanimation-range（幅が狭いほど＝
// Heroの同じスクロール距離をより短時間で駆け抜ける＝手前・速い）で
// パラメータ化している。
//
// rangeStart/rangeEndは元々0%付近（スクロール開始直後）から始まっていたが、
// 「キービジュアルが消えかかったあたりから提灯を流し始めたい」という
// 指示を受け、開始位置を後ろへずらした。band-heroのview-timeline
// （exit 0%〜exit 100%）を基準に、Playwrightで実測したところ
// キービジュアルの上端が画面外へ切れ始めるのがexit進捗 約29%、完全に
// 消えるのが約92%だった。旧レンジ（最小0%〜最大78%）を[29%, 100%]へ
// 線形に写像し直し、6個の相対的な速度差（レンジ幅）はそのまま保っている。
const HERO_STREAM_LANTERNS = [
  { left: '8%', size: 40, peakScale: 1.3, vhStart: 55, vhEnd: 50, rangeStart: 30, rangeEnd: 79 },
  { left: '24%', size: 30, peakScale: 1.15, vhStart: 45, vhEnd: 40, rangeStart: 37, rangeEnd: 91 },
  { left: '42%', size: 46, peakScale: 1.4, vhStart: 60, vhEnd: 55, rangeStart: 32, rangeEnd: 75 },
  { left: '60%', size: 26, peakScale: 1.1, vhStart: 40, vhEnd: 35, rangeStart: 43, rangeEnd: 100 },
  { left: '78%', size: 42, peakScale: 1.35, vhStart: 58, vhEnd: 52, rangeStart: 34, rangeEnd: 78 },
  { left: '94%', size: 32, peakScale: 1.2, vhStart: 48, vhEnd: 42, rangeStart: 41, rangeEnd: 93 },
];

const siteUrl = new URL('/', Astro.site ?? Astro.url).toString();

// 本寺小路ガイドは非公式のファンサイト。Organization.nameは「本寺小路」自体
// ではなく当サイトの名称にし、descriptionにも明示的な断り書きを入れることで、
// 本寺小路そのものの公式運営組織と誤認されないようにする。
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: '本寺小路ガイド',
    url: siteUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: '本寺小路ガイド',
    url: siteUrl,
    description:
      '新潟県三条市の歓楽街「本寺小路」を紹介する非公式のファンサイトです。本寺小路の公式な運営組織ではありません。',
  },
];
---

<Layout title="本寺小路ガイド｜三条市の歓楽街 飲食店・店舗ガイド">
  <StructuredData data={structuredData} />
  <Header />

  <!--
    以前はmain自体にmax-w-5xlをかけ、全セクションが同じ幅を共有していた。
    今回はセクションごとに幅を変える（SPOTSは全幅、FEATURE/NEWSは狭幅の
    読み物幅）ため、幅の制約はmainからは外し、セクション単位で個別に
    mx-auto max-w-*を当てる。
  -->
  <!--
    背景の明暗（band-*）について:
    「暗く始まり、中盤（ハシゴ酒）で最も明るくなり、また暗く終わる」という
    明暗の流れを、ページ長に依存しない形で付ける。1本の巨大なグラデーションを
    main全体にvh/％で敷くと、記事が増減してセクションの相対的な高さ比率が
    変わるたびに「どの明るさがどのセクションに乗るか」がズレてしまうため
    採用しなかった。代わりに、セクションをband-*でグループ化し、各bandが
    「自分の高さの0%〜100%」を基準にした自分専用のグラデーションを持つ
    （中身が増えてbandの実高さが変わっても、bandの中でのグラデーションの
    掛かり方自体は常に同じ比率のまま追従する）。
    band間の境目が線に見えないよう、前後のセクション間の余白（本来はmb/mt）は
    band wrapper自身のpadding-top/bottomに移し替えてある（band wrapperの
    背景がその余白部分ごと塗るため、隙間から素のbody背景が覗かない）。
    色は固定の16進値のみを使い、[data-time]が変えるCSS変数（--glow等）には
    一切触れていないため、時間帯変化とは独立して両方が同時に効く。
  -->
  <main class="relative">
    <!--
      Hero: テキスト部はSPOTS/ハシゴ酒と同じ考え方で内側にmax-w-5xlの
      ラッパーを持つが、キービジュアルはそこから外に出して画面幅いっぱいに
      広げる（sectionそのものはmax-wの外＝mainの直下、テキストだけを
      内側のdivでmax-w-5xlに収める）。
    -->
    <section class="band band-hero relative pb-10 pt-3 sm:pb-14 sm:pt-10">
      <div class="mx-auto max-w-5xl px-4">
        <!-- 街灯からこぼれる火の粉が路地をゆっくり漂う演出。装飾のみで
             情報を持たないためaria-hidden、CSSのみで動く（JS不要）。 -->
        <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
          <span class="ember" style={{ left: '10%', top: '68%', animationDuration: '8.5s', animationDelay: '0s', '--drift-x': '16px' }}></span>
          <span class="ember" style={{ left: '44%', top: '52%', animationDuration: '11s', animationDelay: '-3.5s', '--drift-x': '-12px' }}></span>
          <span class="ember" style={{ left: '80%', top: '62%', animationDuration: '9.5s', animationDelay: '-6.5s', '--drift-x': '20px' }}></span>
        </div>

        <!-- イラストに面積を割くため、見出し〜CTAの余白をさらに詰めた
             （py-3→py-2、後続のmt-3/mt-4はほぼ最小限のためそのまま）。 -->
        <div class="relative px-1 py-2 text-center sm:px-2 sm:py-14 sm:text-left">
          <h1 class="font-serif text-[1.65rem] font-bold leading-[1.45] text-gold-100 text-glow sm:text-3xl">
            灯りともる路地で、<br />今夜の一軒を。
          </h1>
          <p class="mt-3 hidden text-sm leading-relaxed text-gold-100/65 sm:block sm:text-base">
            新潟県三条市の歓楽街「本寺小路」。鍛冶職人の町が育んだ、一見さんも常連も分け隔てない大人の社交街へようこそ。
          </p>
          <a
            href="/spots/"
            class="group mt-3 inline-flex min-h-11 items-center gap-2 rounded-full border border-gold-100/35 bg-night-950/20 px-5 py-2.5 text-sm font-semibold text-amber-glow transition hover:border-amber-glow/70 hover:underline hover:underline-offset-4"
          >
            灯りを探しに行く
            <ArrowRight class="transition-transform duration-150 group-hover:translate-x-1 motion-reduce:transform-none" size={16} stroke-width={2.25} aria-hidden="true" />
          </a>
        </div>
      </div>

      <!--
        キービジュアル: keyvisual.png（実寸804x702、ほぼ正方形）。

        モバイルの高さ指定は h-[42dvh] をやめ h-auto（幅基準）にした。
        実機のSafariで「スクロールするとキービジュアルが動いて見える」
        報告が続いていたが、画面上に実測値を表示するデバッグバッジで
        確認したところ animationName=none / transform=none （＝
        .hero-keyvisual-parallaxのCSSアニメーションは動いていない）
        だった。原因はアニメーションではなく、iOS Safariがスクロールで
        アドレスバー/ツールバーを開閉するたびに dvh（動的ビューポート
        高さ）が変化し、h-[42dvh]で指定していた高さ＝画像の見た目の
        サイズがそのたびに変わって見えていたこと（transformを使わない、
        純粋なレイアウトサイズの変化）だったと判断した。
        幅（w-full）はツールバー開閉の影響を受けないため、高さ指定を
        やめて幅基準にすることでこの揺れを解消する。42dvh時点でも
        ほぼ画面幅いっぱいになる計算だったため、見た目のサイズは
        ほぼ変わらない。
        sm以上は既存のmax-h指定のまま（正方形素材は幅基準のままだと
        デスクトップで縦に間延びするため、変更していない）。

        灯りの表現（3段構成）・パララックス（案B、keyvisual自体の
        scale+translate、640px以上でのみ有効）は変更なし。
      -->
      <div class="hero-keyvisual-parallax relative mt-2 sm:mt-6">
        <div
          class="pointer-events-none absolute inset-0 opacity-50 bg-[radial-gradient(ellipse_38%_46%_at_50%_40%,var(--glow),transparent_58%),radial-gradient(ellipse_85%_95%_at_50%_40%,var(--glow),transparent_85%)]"
          aria-hidden="true"
        >
        </div>
        <img
          src="/images/keyvisual.png"
          width="804"
          height="702"
          alt="赤提灯と「本寺小路」ののれんが灯る路地の様子。居酒屋やスナックの看板が並び、行き交う人影が見える夜の情景。"
          class="keyvisual-fade relative mx-auto h-auto w-full object-contain sm:h-auto sm:max-h-[24rem] lg:max-h-[30rem]"
          loading="eager"
        />
        <img
          src="/images/keyvisual.png"
          width="804"
          height="702"
          alt=""
          aria-hidden="true"
          loading="eager"
          class="keyvisual-bloom pointer-events-none absolute inset-0 mx-auto h-auto w-full object-contain sm:h-auto sm:max-h-[24rem] lg:max-h-[30rem]"
        />
      </div>

      <!--
        パララックスの手前を流れる提灯。前回はkeyvisualの下端付近に小さく
        静止して見えてしまっていた。原因は2つ:
        (1) animation-rangeに cover を使っていた。Heroはページ最上部に
            固定され、初回表示から既に画面内に収まっているため、
            「下から入ってくる」covorの0%起点が実質的に無効化され、
            スクロール0の時点で既に終盤の値（低い不透明度・移動済みの
            位置）を指してしまっていた。band-heroのように常にページ最上部
            にあるブロックには exit（＝これから画面外へ出ていく過程）を
            使うのが正しく、スクロール0で必ずfrom側の値になる。
        (2) 提灯を .hero-keyvisual-parallax の内側（＝キービジュアルの
            狭い縦幅）に閉じ込めていたため、動ける範囲も小さすぎた。
        ここではband-hero全体を覆うoverflow-hiddenのレイヤーとして
        section直下に置き直し、画面下から上へ大きく（dvh単位で）
        通り抜けさせる。overflow-hiddenでHeroの外には一切はみ出さない。
        JSのscrollイベントは使わず、band-hero自身のview-timeline
        （下記<style>参照）だけで動く。6個で固定（描画負荷のため）。
        サイズも視認できるよう26〜46pxに拡大した。
        prefers-reduced-motion / @supports非対応環境ではopacity:0のまま
        （動きが前提の演出なので、動けないなら出さない）。
      -->
      <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        {
          HERO_STREAM_LANTERNS.map((l) => (
            <div
              class="hero-lantern-stream absolute bottom-1/2"
              style={{
                left: l.left,
                '--stream-vh-start': `${l.vhStart}dvh`,
                '--stream-vh-end': `-${l.vhEnd}dvh`,
                '--stream-peak-scale': String(l.peakScale),
                animationRange: `exit ${l.rangeStart}% exit ${l.rangeEnd}%`,
              }}
            >
              <LanternIcon lit size={l.size} />
            </div>
          ))
        }
      </div>
    </section>

    <!--
      営業状況ステータス〜新着店舗: 同じ明るさの帯としてグループ化
      （営業状況は箱を持たない小さな表示なので、単独でband化するほどの
      まとまりが無く、SPOTSと地続きの明るさでよい）。
    -->
    <div class="band band-status-spots">
    <!--
      営業状況ステータス。Heroの世界観と主要CTAを先に見せ、その直後に
      リアルタイム情報を置く。JS無効時は空要素のまま非表示。箱で囲わず、
      共有の背景の上にそのまま浮かせることでHeroからの連続性を保つ。
    -->
    <div class="mx-auto max-w-5xl px-4">
      <section
        data-hero-status
        class="relative mb-14 px-6 py-4 text-center empty:hidden"
        data-spots-hours={JSON.stringify(allSpots.map((s) => s.data.hours ?? null))}
        aria-live="polite"
      />
      <template data-lantern-icon-template><LanternIcon /></template>
    </div>

    <!--
      新着店舗: サイトの主目的なので、リアルタイム営業状況の直後に配置。
      唯一「SPOTS」の英字ラベルを残すセクション。全幅に広げ、PC・SPを問わず
      横スクロールにする。見出しだけmax-w-5xlに揃え、カード列は画面幅
      いっぱいまで伸ばして右端でカードが切れる＝まだ続く、を伝える。
    -->
    <section id="spots" class="scroll-mt-8 pb-16 sm:pb-24" aria-labelledby="spots-heading">
      <div class="mx-auto flex max-w-5xl items-end justify-between gap-4 px-4" id="spots-heading">
        <SectionHeading icon={MapPin} label="SPOTS" accent="amber">新着店舗</SectionHeading>
        <a
          href="/spots/"
          class="hidden shrink-0 items-center gap-1 text-xs text-gold-100/50 transition hover:text-amber-glow sm:inline-flex"
        >
          すべて見る
          <ArrowRight size={12} aria-hidden="true" />
        </a>
      </div>

      <div
        class="mt-6 flex snap-x snap-mandatory gap-4 overflow-x-auto overscroll-x-contain pb-3 pl-4 pr-4 scroll-pl-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:gap-5 sm:pl-[max(1rem,calc(50vw-32rem+1rem))]"
        aria-label="新着店舗一覧"
      >
        {
          /*
            revealIndexは渡さない（= data-revealのスクロール連動フェードイン
            を使わない）。SPOTSは横スクロール行のため、2枚目以降は右端に
            「一部だけ覗く」状態で初期表示される。SectionHeading.astroの
            IntersectionObserverはthreshold:0.2（面積20%以上の交差）で
            revealするが、覗いているのは幅の約18%程度しかなく閾値を
            永遠に超えられない＝2枚目以降がopacity:0のまま固まって消えて
            見える不具合が本番で発生していたため。SpotCard.astro自身の
            コメントが警告する「フィルタ付き一覧では指定しない」と同じ
            クラスの問題（IntersectionObserverの前提が崩れるケース）。
          */
        }
        {
          featuredSpots.map((spot) => (
            <div class="flex w-[78vw] max-w-[20rem] shrink-0 snap-start sm:w-72 lg:w-80">
              <SpotCard spot={spot} />
            </div>
          ))
        }
      </div>

      <p class="mt-3 flex items-center justify-end gap-1 px-4 text-xs text-gold-100/45 sm:hidden" aria-hidden="true">
        横にスワイプして見る
        <ArrowRight size={13} stroke-width={2.25} />
      </p>

      <div class="mt-4 px-4 text-center sm:hidden">
        <a
          href="/spots/"
          class="inline-flex items-center gap-1.5 rounded-full border border-night-600 bg-night-800/60 px-5 py-2.5 text-sm font-medium text-gold-100/80 transition hover:border-amber-deep/60 hover:text-amber-glow"
        >
          店舗一覧をすべて見る
          <ArrowRight size={15} stroke-width={2.25} aria-hidden="true" />
        </a>
      </div>
    </section>
    </div>

    <!--
      鍛冶職人の町が育んだ、夜の文化 + 直後のRuleDivider(noren)をまとめて
      1つの帯にする。以前は6番目（末尾寄り）だったが、サイトの性格を早い
      段階で伝えるためSPOTSの直後に移動。英字ラベルは外し、SectionHeadingも
      使わず素の見出しにする（他の見出しと形を揃えない）。狭いmax-w-2xlの
      まま＝読み物らしさを保ち、背景にだけAlleyNightを薄く敷いて「ここは
      読ませるセクション」という質感を出す。箱（border/背景色）は付けない
      ＝共有の背景の上に直接浮かせる方針は維持。
    -->
    <div class="band band-craft pb-px">
    <div class="mx-auto max-w-2xl px-4">
      <section class="relative py-10 text-center sm:py-14">
        <!-- 背景を先に置き、コンテンツ側に relative を付けて上に重ねる
             （Heroの火の粉演出と同じ順序。absolute配置の背景はz-index:auto
             でも非配置の通常フロー要素より後に描画されるため、コンテンツ側も
             positionedにしないと背景がテキストの上に乗ってしまう）。 -->
        <div class="pointer-events-none absolute inset-0 opacity-[0.16]" aria-hidden="true">
          <AlleyNight ignite="scroll" class="h-full w-full object-cover" />
        </div>
        <div class="relative">
          <h2 class="font-serif text-xl font-bold text-gold-100 sm:text-2xl" data-reveal>
            鍛冶職人の町が育んだ、夜の文化
          </h2>
          <p class="mt-4 leading-loose text-gold-100/70" data-reveal style="--reveal-i:1">
            三条は古くから鍛冶職人の技で知られる「ものづくりの町」。商談に訪れる商人や職人たちが一杯かわす社交場として、本寺小路は生まれました。昭和には料亭やスナックが軒を連ねる最盛期を迎え、令和の今も「一見さんとも常連ともなく、みんなが顔なじみになっていく」独特の距離感を受け継いでいます。
          </p>
          <div class="mt-6 flex flex-wrap justify-center gap-3" data-reveal style="--reveal-i:2">
            <a
              href="/about/"
              class="inline-flex items-center gap-1.5 rounded-full bg-amber-glow px-5 py-2.5 text-sm font-semibold text-night-950 transition hover:brightness-110"
            >
              本寺小路について詳しく読む
              <ArrowRight size={14} stroke-width={2.25} aria-hidden="true" />
            </a>
          </div>
        </div>
      </section>
    </div>

    <!--
      罫線は暖簾（noren）1回のみに絞る。ここから先はハシゴ酒の大きな帯＝
      視覚的な山場に入るので、「雰囲気が変わる」合図として唯一残す。
      band-craftの帯にそのまま含める（境目をこの罫線の手前ではなく
      罫線の直後＝ハシゴ酒の頭に置くことで、「暖簾をくぐったら明るくなる」
      演出と合わせる）。
    -->
    <RuleDivider variant="noren" />
    </div>

    <!--
      ハシゴ酒のカルチャー: 罫線（暖簾）の直後にイラストを続けると、絵が
      2つ連続して見た目がうるさくなるため、テキスト→イラストの順に変更。
      「読んだあとに情景が浮かぶ」流れを意図している。2カラム化はやめ、
      モバイル・PCとも同じ縦の流れ（見出し→本文→CTA→イラスト）に統一。
      イラストは元の画角のまま欠けなく見せる（object-contain）。
      band-hashigoはページ全体で最も明るい帯（山場）にする。
    -->
    <section class="band band-hashigo relative pb-16 sm:pb-24" aria-labelledby="hashigo-heading">
      <div class="mx-auto max-w-2xl px-4 text-center" data-reveal>
        <h2
          id="hashigo-heading"
          class="font-serif text-2xl font-bold text-gold-100 [line-break:strict] sm:text-3xl"
        >
          1軒目・2軒目・締め、<br class="sm:hidden" />ハシゴ酒のカルチャー
        </h2>
        <p class="mt-4 leading-loose text-gold-100/70">
          居酒屋で軽く始め、BARやスナックでじっくり語らい、ラーメンやおでんで締めくくる——本寺小路には、路地一本でハシゴが完結する独特の密度があります。初めての方も、その日の気分で自由に組み立ててみてください。
        </p>
        <a
          href="/about/#hashigo"
          class="mt-6 inline-flex items-center gap-1.5 rounded-full bg-amber-glow px-5 py-2.5 text-sm font-semibold text-night-950 transition hover:brightness-110"
        >
          ハシゴ酒の心得を読む
          <ArrowRight size={14} stroke-width={2.25} aria-hidden="true" />
        </a>
      </div>
      <img
        src="/images/hasigozake.png"
        width="1330"
        height="523"
        alt="1軒目、2軒目、3杯目と暖簾をハシゴして本寺小路の門へ向かう、盃を手にしたイラスト"
        loading="lazy"
        class="relative mx-auto mt-8 w-full max-w-2xl object-contain drop-shadow-[0_0_28px_rgba(242,181,68,0.25)] sm:mt-10 sm:max-w-3xl"
      />
    </section>

    <!--
      本寺小路夜話〜お知らせ: ハシゴ酒の山場を通り過ぎ、再び静かな明るさに
      落とす帯。columnsが0件でもband自体は常に存在させる（お知らせだけの
      時にband-tailが消えてしまわないように、条件分岐はband wrapperの
      内側に置く）。
    -->
    <div class="band band-tail pb-6 sm:pb-10">
    <!-- 本寺小路夜話: 現状維持（カードgrid）。英字ラベルは外し、日本語見出しのみ。 -->
    {
      columns.length > 0 && (
        <div class="mx-auto max-w-5xl px-4">
          <section class="mb-16 sm:mb-20" aria-labelledby="columns-heading">
            <div class="flex items-end justify-between gap-4" id="columns-heading">
              <h2 class="font-serif text-xl font-bold text-gold-100 sm:text-2xl">本寺小路夜話</h2>
              <a href="/columns/" class="hidden items-center gap-1 text-xs text-gold-100/50 transition hover:text-amber-glow sm:inline-flex">
                すべて読む <ArrowRight size={12} aria-hidden="true" />
              </a>
            </div>
            <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {columns.map((column, i) => <ColumnCard column={column} revealIndex={i} />)}
            </div>
            <div class="mt-5 text-center sm:hidden"><a href="/columns/" class="inline-flex items-center gap-1 text-sm text-amber-glow">本寺小路夜話をすべて読む <ArrowRight size={13} aria-hidden="true" /></a></div>
          </section>
        </div>
      )
    }

    <!--
      お知らせ: 更新情報は主役ではないため末尾に移動。英字ラベルを外し、
      見出しも小さく。カードやアイコンバッジを持たない、日付+タイトルだけの
      簡素なリストにして「ここはおまけ」という重みの軽さを見た目でも示す。
    -->
    <div class="mx-auto max-w-2xl px-4">
      <section aria-labelledby="news-heading">
        <h2 id="news-heading" class="text-sm font-semibold tracking-wide text-gold-100/60">お知らせ</h2>

        {
          news.length > 0 ? (
            <ul class="mt-3 divide-y divide-night-800">
              {news.map((item) => (
                <li class="flex items-center gap-3 py-2.5 text-sm">
                  <time class="shrink-0 text-xs tabular-nums text-gold-100/40" datetime={item.data.pubDate.toISOString().slice(0, 10)}>
                    {item.data.pubDate.toISOString().slice(0, 10)}
                  </time>
                  <a
                    href={`/news/${item.id}/`}
                    class="min-w-0 flex-1 truncate text-gold-100/70 underline-offset-4 transition hover:text-amber-glow hover:underline"
                  >
                    {item.data.title}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-3 text-center text-sm text-gold-100/55">現在お知らせはありません。</p>
          )
        }

        <div class="mt-3 text-right">
          <a
            href="/news/"
            class="inline-flex items-center gap-1 text-xs font-medium text-gold-100/50 transition hover:text-amber-glow"
          >
            ニュース一覧を見る
            <ArrowRight size={12} stroke-width={2.25} aria-hidden="true" />
          </a>
        </div>
      </section>
    </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  // Hero上部の営業状況ステータス。JS無効時は data-hero-status の要素が
  // 空のままとなり、empty:hidden（Tailwind）でセクションごと非表示になる
  // （誤情報を出さないため。OpenStatus.astroと同じ「空要素→JSで埋める」方針）。
  import { getOpenStatus, type HourRule } from '../lib/hours';

  interface Snapshot {
    hh: string;
    mm: string;
    knownCount: number;
    openCount: number;
  }

  function computeSnapshot(el: HTMLElement, now: Date): Snapshot {
    let hoursList: (HourRule[] | null)[] = [];
    try {
      hoursList = JSON.parse(el.dataset.spotsHours ?? '[]');
    } catch {
      hoursList = [];
    }

    const parts = new Intl.DateTimeFormat('ja-JP', {
      timeZone: 'Asia/Tokyo',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    }).formatToParts(now);
    const hh = parts.find((p) => p.type === 'hour')?.value ?? '--';
    const mm = parts.find((p) => p.type === 'minute')?.value ?? '--';

    // hours不明（未掲載）の店は分母から除外する。
    const known = hoursList.filter((h): h is HourRule[] => Array.isArray(h) && h.length > 0);
    const openCount = known.filter((h) => {
      const result = getOpenStatus(h, now);
      return result.state === 'open' || result.state === 'closing-soon';
    }).length;

    return { hh, mm, knownCount: known.length, openCount };
  }

  // 提灯を並べる上限。9個以上は8個並べて末尾に "+N" を添える。
  // 掲載店舗が増えても崩れないよう、値はここだけ変えれば追随する。
  const LANTERN_DISPLAY_CAP = 8;

  function cloneLanternIcon(): SVGElement {
    const template = document.querySelector<HTMLTemplateElement>('template[data-lantern-icon-template]');
    const node = template!.content.firstElementChild!.cloneNode(true) as SVGElement;
    return node;
  }

  /** 点灯中の提灯をopenCount分（上限LANTERN_DISPLAY_CAP）並べた行を作る。 */
  function buildLanternRow(openCount: number): HTMLElement {
    const row = document.createElement('div');
    row.dataset.statusLanterns = '';
    row.setAttribute('aria-hidden', 'true');
    row.className = 'mt-3 flex flex-wrap items-center justify-center gap-1.5';

    const visibleCount = Math.min(openCount, LANTERN_DISPLAY_CAP);
    for (let i = 0; i < visibleCount; i++) {
      const icon = cloneLanternIcon();
      icon.classList.add('is-lit', 'is-breathing');
      (icon as unknown as HTMLElement).style.animationDelay = `${(-i * 0.35).toFixed(2)}s`;
      row.appendChild(icon);
    }
    if (openCount > LANTERN_DISPLAY_CAP) {
      const overflow = document.createElement('span');
      overflow.className = 'ml-0.5 text-xs font-medium text-gold-100/50';
      overflow.textContent = `+${openCount - LANTERN_DISPLAY_CAP}`;
      row.appendChild(overflow);
    }
    return row;
  }

  function buildLinkWithArrow(href: string, label: string): HTMLAnchorElement {
    const link = document.createElement('a');
    link.href = href;
    link.className =
      'group mt-4 inline-flex items-center gap-1 text-sm font-medium text-amber-glow underline-offset-4 transition hover:text-amber-glow/80 hover:underline';
    const linkLabel = document.createElement('span');
    linkLabel.textContent = label;
    const arrow = document.createElement('span');
    arrow.className = 'inline-block transition-transform duration-150 group-hover:translate-x-1';
    arrow.textContent = '→';
    link.append(linkLabel, arrow);
    return link;
  }

  function buildFootnote(): HTMLElement {
    const footnote = document.createElement('p');
    footnote.className = 'mt-4 text-[0.65rem] text-gold-100/30';
    footnote.textContent = '※掲載されている営業時間をもとに表示';
    return footnote;
  }

  function buildEyebrow(): HTMLElement {
    const eyebrow = document.createElement('p');
    eyebrow.className = 'text-xs tracking-[0.2em] text-gold-100/50';
    eyebrow.textContent = '今夜の本寺小路';
    return eyebrow;
  }

  // 初回のcount状態表示だけ、0から実数へごく短時間（420ms）でカウントアップ
  // する。数字は表示直後から動き始めるため「演出のせいで待たされる」感は
  // 出ない（＝buildCountState呼び出し時点の「即座に確定値を出す」方針は
  // 崩していない）。60秒毎の再評価による更新（軒数が変わった時）は
  // status-fadeの短いフェードのみのまま変更しない（renderの別経路）。
  function animateCount(el: HTMLElement, to: number) {
    if (to <= 0 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.textContent = String(to);
      return;
    }
    const duration = 420;
    const start = performance.now();
    function tick(now: number) {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - (1 - progress) ** 3; // ease-out cubic
      el.textContent = String(Math.round(eased * to));
      if (progress < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  function buildCountState(snapshot: Snapshot): HTMLElement[] {
    const label = document.createElement('p');
    label.className = 'mt-1 text-sm text-gold-100/60';
    label.textContent = '灯りがついている店';

    const numberWrap = document.createElement('p');
    numberWrap.dataset.statusCountWrap = '';
    numberWrap.className = 'hero-status-number mt-3 flex items-baseline justify-center gap-1';
    const countSpan = document.createElement('span');
    countSpan.dataset.statusCount = '';
    countSpan.className = 'text-[3rem] font-bold tabular-nums text-amber-glow sm:text-[3.5rem]';
    animateCount(countSpan, snapshot.openCount);
    const unitSpan = document.createElement('span');
    unitSpan.className = 'text-[1.25rem] text-gold-100/70';
    unitSpan.textContent = '軒';
    numberWrap.append(countSpan, unitSpan);

    const lanterns = buildLanternRow(snapshot.openCount);

    const time = document.createElement('p');
    time.dataset.statusTime = '';
    time.className = 'mt-3 text-xs text-gold-100/55';
    time.textContent = `${snapshot.hh}:${snapshot.mm} 現在`;

    const link = buildLinkWithArrow('/spots/?open=now', '今夜の店を見る');

    return [buildEyebrow(), label, numberWrap, lanterns, time, link, buildFootnote()];
  }

  function buildZeroState(): HTMLElement[] {
    const lanternWrap = document.createElement('div');
    lanternWrap.className = 'mt-3 flex justify-center';
    lanternWrap.setAttribute('aria-hidden', 'true');
    const unlitLantern = cloneLanternIcon();
    unlitLantern.classList.add('is-unlit');
    lanternWrap.appendChild(unlitLantern);

    const message = document.createElement('p');
    message.className = 'mt-3 text-base font-medium text-gold-100/70 sm:text-lg';
    message.textContent = '今はどの灯りも消えています';

    const link = buildLinkWithArrow('/spots/', '店舗一覧を見る');

    return [buildEyebrow(), lanternWrap, message, link, buildFootnote()];
  }

  // 定期再評価タイマーのID自体は多重登録防止のためモジュールスコープに置く
  // （spots/index.astro / OpenStatus.astroと同じ方針。中身のlastState等とは違い、
  // 「前回のタイマーをclearできるか」だけが重要でページ間の値の意味は持たない）。
  let heroStatusIntervalId: ReturnType<typeof setInterval> | undefined;

  // 前回描画時の状態種別・軒数。astro:page-loadのたびにinitHeroStatusが
  // 再実行されて作り直される関数スコープの変数なので、ページ遷移をまたいで
  // 古い値と比較してしまう心配は無い（モジュールスコープにはしない）。
  function initHeroStatus() {
    const el = document.querySelector<HTMLElement>('[data-hero-status]');
    if (!el) return; // このページにHeroステータスが無ければ何もしない

    let lastState: 'count' | 'zero' | null = null;
    let lastOpenCount: number | null = null;

    function render() {
      const snapshot = computeSnapshot(el!, new Date());
      const nextState: 'count' | 'zero' = snapshot.openCount > 0 ? 'count' : 'zero';

      if (nextState !== lastState) {
        // 状態種別が変わった（または初回描画）: 作り直す。フェードは付けない
        // （初期表示は即座に確定値を出す。演出で待たせない）。
        el!.replaceChildren(...(nextState === 'count' ? buildCountState(snapshot) : buildZeroState()));
        lastState = nextState;
        lastOpenCount = nextState === 'count' ? snapshot.openCount : null;
        return;
      }

      if (nextState === 'zero') return; // zero状態には動的に更新すべき要素が無い

      // count状態を維持: 時刻は毎tick最新化する（数字が変わったかどうかに
      // 関わらず常に進める）。数字・提灯行は「営業中の軒数」が変わった時だけ
      // 作り直し、フェードは数字側にのみ付ける。
      const timeEl = el!.querySelector<HTMLElement>('[data-status-time]');
      if (timeEl) timeEl.textContent = `${snapshot.hh}:${snapshot.mm} 現在`;

      if (snapshot.openCount !== lastOpenCount) {
        const countSpan = el!.querySelector<HTMLElement>('[data-status-count]');
        const wrap = el!.querySelector<HTMLElement>('[data-status-count-wrap]');
        const lanternsEl = el!.querySelector<HTMLElement>('[data-status-lanterns]');
        if (countSpan) countSpan.textContent = String(snapshot.openCount);
        if (lanternsEl) lanternsEl.replaceWith(buildLanternRow(snapshot.openCount));
        if (wrap) {
          wrap.classList.remove('status-fade');
          // 同じアニメーションを連続で再トリガーするための強制リフロー。
          void wrap.offsetWidth;
          wrap.classList.add('status-fade');
        }
        lastOpenCount = snapshot.openCount;
      }
      // 軒数が変わっていなければ数字・提灯行には触れない（時刻の更新のみ）。
    }

    render();

    if (heroStatusIntervalId !== undefined) clearInterval(heroStatusIntervalId);
    heroStatusIntervalId = setInterval(render, 60_000);
  }

  document.addEventListener('astro:page-load', initHeroStatus);
</script>

<style>
  /*
    Heroパララックス（案B）。JSのscrollイベントは使わず、CSSのスクロール
    駆動アニメーションだけで実装する。既存のAlleyNight.astro（.street-glow）
    ・RuleDivider（.rule-motion、global.css）と同じく
    @supports (animation-timeline: view()) で機能検出し、非対応ブラウザでは
    このブロック自体が丸ごとマッチしないため、通常表示（静止したHero）に
    自然にフォールバックする。

    band-heroに1本だけ named view-timeline（--hero-scroll）を張り、
    キービジュアルと提灯6個の両方がこれを参照する。各レイヤーが個別に
    無名のview()を使うと、Hero内での位置（テキストの下か、キービジュアルの
    下かなど）によって「どこからHeroに入ったとみなすか」がレイヤーごとに
    微妙にズレてしまうため、band-hero自身の可視範囲という1つの基準に
    全レイヤーを揃えている。

    animation-rangeは exit 0%〜exit 100%を使う（cover ではない）。
    band-heroはページ最上部に固定されたブロックで、スクロール0の時点で
    既に画面内に収まっている＝「下から入ってくる」covorの0%起点が
    実質的に存在しない（初回描画から既にcoverの終盤寄りの値になって
    しまい、提灯が最初から色褪せた位置で止まって見える不具合の原因
    だった）。ページ最上部固定のブロックには「これから画面外へ出ていく
    過程」を表すexitを使うのが正しく、スクロール0で必ずfrom側（提灯
    未到達・keyvisualは静止）の値になる。Heroの範囲だけで完結し、
    ページ全体には広げない。
  */
  @supports (animation-timeline: view()) {
    .band-hero {
      view-timeline-name: --hero-scroll;
      view-timeline-axis: block;
    }
  }
  /* 提灯レイヤーは「動くこと」自体が演出なので、@supports非対応
     環境・prefers-reduced-motion（global.css側で!important上書き）では
     出さない。 */
  .hero-lantern-stream {
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      /*
        キービジュアル自体のパララックス（scale+translate）はモバイルで
        やめる（提灯の「手前を通り過ぎる」演出だけ残す）。640px以上
        （Tailwindのsmと同じ基準）でのみ有効化する。モバイルはアニメー
        ションが付かないぶん、常にtransformなし＝元のサイズ（w-full）の
        まま表示される（アクセス直後から最大幅で見える、を兼ねる）。
      */
      @media (min-width: 640px) {
        .hero-keyvisual-parallax {
          animation-name: hero-kv-drift;
          animation-timing-function: linear;
          animation-fill-mode: both;
          animation-timeline: --hero-scroll;
          animation-range: exit 0% exit 100%;
        }
      }
      .hero-lantern-stream {
        /* animation-range は各インスタンスの style属性で個別に指定する
           （手前ほど早く・大きく動く＝「奥/中景/手前」の速度差を
           1つのkeyframeのまま範囲だけずらして表現するため）。 */
        animation-name: hero-lantern-stream;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --hero-scroll;
        will-change: transform, opacity;
      }
    }
  }
  @keyframes hero-kv-drift {
    from {
      transform: translateY(0) scale(1);
    }
    to {
      /* わずかに拡大しながら少し上へ流れる＝「奥へ進んでいく」感覚。
         スケールもtranslateも小さめの値に留め、提灯の灯り・本文の
         可読性を損なわないようにしている。 */
      transform: translateY(-16px) scale(1.05);
    }
  }
  /*
    提灯: 画面下から現れ（縮小・不透明0＝未到達）、中央で最大に灯って
    （原寸〜peak-scaleまで拡大・完全点灯）、画面上へ抜けていく
    （縮小・不透明0＝通過済み）、という「手前を通り過ぎる」動き。
    移動量はdvh単位（--stream-vh-start/--stream-vh-end、インスタンスごとに
    style属性で指定）にして、画面の高さに対して実際に大きく動いて見える
    ようにしてある。透明かつ縮小した状態で出入りするため、Hero自体には
    overflow-hiddenを掛けているものの、見た目の上でも唐突に切れて見えない。
  */
  @keyframes hero-lantern-stream {
    0% {
      transform: translateY(var(--stream-vh-start, 55dvh)) scale(0.6);
      opacity: 0;
    }
    14% {
      opacity: 1;
    }
    50% {
      transform: translateY(0) scale(var(--stream-peak-scale, 1.2));
      opacity: 1;
    }
    86% {
      opacity: 1;
    }
    100% {
      transform: translateY(var(--stream-vh-end, -50dvh)) scale(0.6);
      opacity: 0;
    }
  }

  /*
    セクション背景の明暗（band-*）。各bandは「自分自身の高さ」を基準にした
    to-bottomの2〜3色グラデーションを持ち、隣接するbandの境界色を
    ぴったり一致させることで、bandの実際の高さ（＝中のコンテンツ量）が
    変わってもグラデーションが必ず連続して見えるようにしてある
    （--band-from/--band-toをbandごとに変えるだけの構造にして、
    今後の色調整もこの変数だけ触ればよいようにした）。
    値はすべて固定の16進色で、[data-time]が書き換える--sky-*/--glowには
    一切依存しないため、時間帯変化と独立に働く（両方が同時に効いても、
    このグラデーションは--glow等の値を参照していないので破綻しない）。
  */
  .band {
    background-repeat: no-repeat;
  }
  /*
    色は全bandで同じ暖色比率（#14110fのR:G:B比、おおよね1.33:1.13:1）を
    保った墨・生成り寄りの暖色グレーのみを使い、明度（lightness）だけを
    上げ下げする。Tailwindの--color-night-*スケール（濃紺〜漆黒、Bチャンネル
    が最大の寒色系）は今回のグラデーションでは一切使わない
    ＝このサイトの配色（墨・生成り・朱・行灯の黄）から外れた紫〜藍に
    転ばないようにするため。 */
  .band-hero {
    /* 最も暗く。#14110fはkeyvisualの発光を最大限見せるための墨色
       （column挿絵のロック背景色と同じ値を流用）。 */
    background-image: linear-gradient(to bottom, #14110f, #1a1613);
  }
  .band-status-spots {
    /* やや明るく。 */
    background-image: linear-gradient(to bottom, #1a1613, #221d18);
  }
  .band-craft {
    /* 中間。 */
    background-image: linear-gradient(to bottom, #221d18, #2c251f);
  }
  .band-hashigo {
    /* 最も明るく（山場）。自分自身の中でentry→peak(50%)→exitと
       盛り上がって落ちる、他のbandとは違う3色グラデーションにしている。
       ピークの#362d25は提灯の灯りが差し込んで少し温まった程度の明るさに
       留め、白っぽくなり過ぎない範囲に収めた。 */
    background-image: linear-gradient(to bottom, #2c251f, #362d25 50%, #241f1a);
  }
  .band-tail {
    /* 再び暗く。Hero起点の#14110fにそのまま帰着させ、始まりと呼応させる。 */
    background-image: linear-gradient(to bottom, #241f1a, #14110f);
  }

  /*
    Heroキービジュアルの四辺を背景色へ溶け込ませるマスク。
    Illust.astroの.ill-maskと同じく-webkit-mask-*とmask-*を両方書く
    （非対応ブラウザではmask-imageが単に無視され、通常表示にフォール
    バックするので@supportsでの分岐は不要）。
    フェード区間は狭め（左右6-94%・下10-82%）にしてある。以前は下辺の
    フェードを38%地点から溶かしていたが、絵の大半が薄く消えて
    「小さく収まって見える」原因になっていたため、この狭い区間に
    揃えた（keyvisual.png/keyvisual2.webpのどちらでも共通）。
  */
  .keyvisual-fade {
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, #000 6%, #000 94%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, #000 10%, #000 82%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent 0%, #000 6%, #000 94%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, #000 10%, #000 82%, transparent 100%);
    mask-composite: intersect;

    /*
      brightness/contrast: 墨色背景に対して生成り色の線が沈んで見える
      対策。線自体は元々そこまで明るくないため、白飛びしない範囲で
      控えめに持ち上げる。
      drop-shadow x3: 提灯の色が「付いているだけ」で灯って見えない
      問題への対応。同じ色を半径違いで3枚重ねるのは、単発のdrop-shadowが
      1回の半透明合成にとどまり弱い光にしかならないため（CSSでの疑似
      ブルーム表現の定石）。色は--glow（AlleyNightの街灯グローと同じ
      変数、[data-time]で時間帯ごとに色相・強度が変わる）をそのまま使い、
      提灯の色でなく「その場の時間帯の灯り」に連動させる。
      前回4段重ねにしたところ全体が白っぽく発光し「夜でなく昼」に
      見えてしまったため、半径・段数を約半分に戻した
      （暗がりの中に灯りがある、というコントラストを優先する）。
    */
    filter:
      brightness(1.18) contrast(1.1)
      drop-shadow(0 0 12px var(--glow))
      drop-shadow(0 0 30px var(--glow))
      drop-shadow(0 0 65px var(--glow));
  }

  /*
    keyvisual-fadeと同じ画像をもう1枚、絶対配置で重ねた「発光レイヤー」。
    drop-shadowは画像全体のシルエットに対して均一な光暈を足すだけなので、
    「提灯の色が付いているだけ」問題（個々の光源が発光して見えない）は
    解決しない。ここでは彩度・明るさを上げてからぼかし、
    mix-blend-mode:screenで下のレイヤーに合成する。screenは暗い色
    （黒に近い線画・背景）にはほとんど作用せず、明るく彩度の高い画素
    （提灯・行灯の朱色〜琥珀色）だけを持ち上げるため、結果として
    提灯・行灯の位置だけがにじんで光って見える。マスクは適用しない
    （ぼかしが元の輪郭より外側へにじみ出ることこそが「光が漏れる」
    表現になるため）。

    強度は前回（saturate 2.6 / brightness 1.55 / blur 14px / opacity 0.85）
    だと全体が白く発光し昼のように見えたため、CSS変数にして半分程度
    まで落とした。今後の微調整はこの変数群だけを触ればよい。
  */
  .keyvisual-bloom {
    --kv-bloom-saturate: 1.7;
    --kv-bloom-brightness: 1.25;
    --kv-bloom-blur: 9px;
    --kv-bloom-opacity: 0.42;
    filter: saturate(var(--kv-bloom-saturate)) brightness(var(--kv-bloom-brightness)) blur(var(--kv-bloom-blur));
    mix-blend-mode: screen;
    opacity: var(--kv-bloom-opacity);
  }

  /*
    モバイルでHeroパララックスがカクつく報告への対応。transform自体
    （translateY/scale）はコンポジタだけで動くはずだが、実際に動いて
    いるのはfilter（drop-shadow・blur）とmix-blend-mode:screenを
    何層も重ねた画像で、これらは合成コストが高く、非力なモバイルGPUだと
    スクロール駆動アニメーションの毎フレーム再合成が追いつかない
    （animation-timelineの仕組み自体は主スレッドを使わないぶん軽いが、
    合成側の負荷は別問題）。keyvisual-fade/keyvisual-bloomの重ね順・
    発光の意図は変えず、モバイルだけ量を減らして合成コストを下げる:
    - keyvisual-fade: drop-shadowを3段→1段に
    - keyvisual-bloom: blur半径を縮小し、mix-blend-mode:screen
      （モバイルGPUで特にコストが高いブレンドモード）をやめてnormal合成に
      （発光の滲みは弱まるが、screen本来の「暗部を持ち上げない」性質を
      opacityの低さで代用する）
  */
  @media (max-width: 639px) {
    .keyvisual-fade {
      filter: brightness(1.18) contrast(1.1) drop-shadow(0 0 28px var(--glow));
    }
    .keyvisual-bloom {
      --kv-bloom-blur: 5px;
      mix-blend-mode: normal;
      opacity: calc(var(--kv-bloom-opacity) * 0.55);
    }
  }
</style>
