---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SpotCard from '../../components/SpotCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import EmptyState from '../../components/EmptyState.astro';
import GenreIcon from '../../components/GenreIcon.astro';
import StructuredData from '../../components/StructuredData.astro';
import { getCollection } from 'astro:content';
import { MapPin } from '@lucide/astro';

const spots = (await getCollection('spots')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: spots.map((spot, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(`/spots/${spot.id}/`, Astro.site ?? Astro.url).toString(),
  })),
};

const genres = [...new Set(spots.map((spot) => spot.data.genre))].sort();

const scenes = [
  { key: '1st', label: '1軒目', value: '1軒目におすすめ' },
  { key: 'shime', label: '2次会・締め', value: '2次会・締めに最適' },
  { key: 'late', label: '深夜営業', value: '深夜営業' },
];

// budgetMin（数値・任意）に対する「〜◯◯円」の固定バケット。キーはURLクエリにもそのまま使う。
// 判定はbudgetMin基準（下限が◯◯円以内なら候補に含める）。詳細は下のmatchesBudgetを参照。
const budgets = [
  { key: '2000', label: '〜￥2,000' },
  { key: '3000', label: '〜￥3,000' },
  { key: '5000', label: '〜￥5,000' },
  { key: '5000plus', label: '￥5,000〜' },
];

const seatTypes = [
  { key: 'counter', label: 'カウンター', value: 'カウンター席あり' },
  { key: 'private', label: '個室', value: '個室あり' },
  { key: 'tatami', label: '座敷・小上がり', value: '座敷・小上がりあり' },
];
---

<Layout
  title="店舗一覧｜本寺小路ガイド"
  description="新潟県三条市の歓楽街「本寺小路」の飲食店・店舗を、ジャンル・シーン・予算・席タイプ・今営業中かどうかで絞り込んで探せます。"
>
  <StructuredData data={structuredData} />
  <Header />

  <main class="mx-auto max-w-5xl px-4 py-10">
    <SectionHeading icon={MapPin} label="SPOTS" accent="amber" level="h1">店舗一覧</SectionHeading>

    <div class="mt-6 space-y-3">
      <div>
        <p class="mb-2 text-xs font-medium tracking-wide text-gold-100/40">ジャンルで絞り込み</p>
        <div class="flex flex-wrap gap-2" data-filter-group="genre">
          <button
            type="button"
            data-value="all"
            aria-pressed="true"
            class="filter-btn rounded-full border border-night-600 bg-night-800/60 px-3.5 py-1.5 text-xs font-medium text-gold-100/70 transition hover:border-amber-deep/60 hover:text-amber-glow"
          >
            すべて
          </button>
          {
            genres.map((genre) => (
              <button
                type="button"
                data-value={genre}
                aria-pressed="false"
                class="filter-btn inline-flex items-center gap-1.5 rounded-full border border-night-600 bg-night-800/60 px-3.5 py-1.5 text-xs font-medium text-gold-100/70 transition hover:border-amber-deep/60 hover:text-amber-glow"
              >
                <GenreIcon genre={genre} size={14} />
                {genre}
              </button>
            ))
          }
        </div>
      </div>

      <div>
        <p class="mb-2 text-xs font-medium tracking-wide text-gold-100/40">シーンで絞り込み</p>
        <div class="flex flex-wrap gap-2" data-filter-group="scene">
          <button
            type="button"
            data-value="all"
            aria-pressed="true"
            class="filter-btn rounded-full border border-night-600 bg-night-800/60 px-3.5 py-1.5 text-xs font-medium text-gold-100/70 transition hover:border-amber-deep/60 hover:text-amber-glow"
          >
            すべて
          </button>
          {
            scenes.map((scene) => (
              <button
                type="button"
                data-value={scene.key}
                data-match={scene.value}
                aria-pressed="false"
                class="filter-btn rounded-full border border-night-600 bg-night-800/60 px-3.5 py-1.5 text-xs font-medium text-gold-100/70 transition hover:border-amber-deep/60 hover:text-amber-glow"
              >
                {scene.label}
              </button>
            ))
          }
        </div>
      </div>

      <div>
        <p class="mb-2 text-xs font-medium tracking-wide text-gold-100/40">予算帯で絞り込み</p>
        <div class="flex flex-wrap gap-2" data-filter-group="budget">
          <button
            type="button"
            data-value="all"
            aria-pressed="true"
            class="filter-btn rounded-full border border-night-600 bg-night-800/60 px-3.5 py-1.5 text-xs font-medium text-gold-100/70 transition hover:border-amber-deep/60 hover:text-amber-glow"
          >
            すべて
          </button>
          {
            budgets.map((budget) => (
              <button
                type="button"
                data-value={budget.key}
                aria-pressed="false"
                class="filter-btn rounded-full border border-night-600 bg-night-800/60 px-3.5 py-1.5 text-xs font-medium text-gold-100/70 transition hover:border-amber-deep/60 hover:text-amber-glow"
              >
                {budget.label}
              </button>
            ))
          }
        </div>
      </div>

      <div>
        <p class="mb-2 text-xs font-medium tracking-wide text-gold-100/40">席タイプで絞り込み</p>
        <div class="flex flex-wrap gap-2" data-filter-group="seat">
          <button
            type="button"
            data-value="all"
            aria-pressed="true"
            class="filter-btn rounded-full border border-night-600 bg-night-800/60 px-3.5 py-1.5 text-xs font-medium text-gold-100/70 transition hover:border-amber-deep/60 hover:text-amber-glow"
          >
            すべて
          </button>
          {
            seatTypes.map((seat) => (
              <button
                type="button"
                data-value={seat.key}
                data-match={seat.value}
                aria-pressed="false"
                class="filter-btn rounded-full border border-night-600 bg-night-800/60 px-3.5 py-1.5 text-xs font-medium text-gold-100/70 transition hover:border-amber-deep/60 hover:text-amber-glow"
              >
                {seat.label}
              </button>
            ))
          }
        </div>
      </div>

      <div>
        <p class="mb-2 text-xs font-medium tracking-wide text-gold-100/40">その他の条件で絞り込み</p>
        <div class="flex flex-wrap gap-2">
          <button
            type="button"
            data-open-toggle
            aria-pressed="false"
            class="filter-btn rounded-full border border-night-600 bg-night-800/60 px-3.5 py-1.5 text-xs font-medium text-gold-100/70 transition hover:border-amber-deep/60 hover:text-amber-glow"
          >
            今営業中
          </button>
          <button
            type="button"
            data-video-toggle
            aria-pressed="false"
            class="filter-btn rounded-full border border-night-600 bg-night-800/60 px-3.5 py-1.5 text-xs font-medium text-gold-100/70 transition hover:border-amber-deep/60 hover:text-amber-glow"
          >
            動画あり
          </button>
        </div>
      </div>
    </div>

    <div class="mt-6 flex items-baseline justify-between">
      <p class="text-xs text-gold-100/40" data-result-count>{spots.length}件</p>
    </div>

    <div class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" data-spot-grid>
      {spots.map((spot) => <SpotCard spot={spot} />)}
    </div>

    <EmptyState message="条件に合う店舗が見つかりませんでした。" class="hidden" />
  </main>

  <Footer />
</Layout>

<style>
  .filter-btn[aria-pressed='true'] {
    border-color: var(--color-amber-deep);
    background-color: var(--color-amber-glow);
    color: var(--color-night-950);
  }
</style>

<script>
  import { getOpenStatus, type HourRule } from '../../lib/hours';

  // 判定は budgetMax（上限）ではなく budgetMin（下限）で行う。「〜¥3,000」は
  // 「3,000円で入れる可能性がある店」を探す意味合いなので、budget
  // "¥3,000〜¥4,000" の店（budgetMin=3000）も「〜¥3,000」の候補に含める。
  // "2000"/"3000"/"5000" は「下限がその金額以下」（budgetMin <= 値）。
  // "5000plus" だけは向きが逆で「下限が5,000円より上」（budgetMin > 5000）を
  // 表す特別扱い。ラベル文字列（〜¥2,000等）自体は変更しない。
  const BUDGET_MIN_OR_LESS: Record<string, number> = {
    '2000': 2000,
    '3000': 3000,
    '5000': 5000,
  };
  const BUDGET_PLUS_THRESHOLD = 5000;

  // budgetMinが無い店は、営業中フィルタでのunknown除外と同じ方針で
  // 「すべて」以外のキーが選ばれているときは除外する（実際の予算帯が
  // 分からない店を、特定の予算帯の候補として誤って見せないため）。
  function matchesBudget(cardBudgetMin: number | undefined, budgetKey: string): boolean {
    if (budgetKey === 'all') return true;
    if (cardBudgetMin === undefined) return false;
    if (budgetKey === '5000plus') return cardBudgetMin > BUDGET_PLUS_THRESHOLD;
    const min = BUDGET_MIN_OR_LESS[budgetKey];
    return min !== undefined && cardBudgetMin <= min;
  }

  function parseHours(raw: string | undefined): HourRule[] | undefined {
    if (!raw || raw === 'null') return undefined;
    try {
      const parsed = JSON.parse(raw);
      return Array.isArray(parsed) ? parsed : undefined;
    } catch {
      return undefined;
    }
  }

  function group(name: string): HTMLElement | null {
    return document.querySelector<HTMLElement>(`[data-filter-group="${name}"]`);
  }

  /** グループ内で選択中のボタンの data-value（URL同期にも使う短いkey）。未選択なら 'all'。 */
  function activeKey(el: HTMLElement | null): string {
    const pressed = el?.querySelector<HTMLButtonElement>('.filter-btn[aria-pressed="true"]');
    return pressed?.dataset.value ?? 'all';
  }

  /** グループ内で選択中のボタンの実際の照合値（data-matchがあればそれ、無ければdata-value自身）。 */
  function activeMatch(el: HTMLElement | null): string {
    const pressed = el?.querySelector<HTMLButtonElement>('.filter-btn[aria-pressed="true"]');
    return pressed?.dataset.match ?? pressed?.dataset.value ?? 'all';
  }

  /**
   * URLクエリ由来の value でボタンを選択する。genreは"BAR"のようにコンテンツの
   * 生の値をそのまま data-value として使っており、英字の大文字小文字まで
   * URLに正確に一致させるのは利用者に酷なので、比較は大文字小文字を区別しない
   * （scene/budget/seatは元々小文字固定keyなので実質影響なし）。
   * 一致しなければ何もしない＝該当グループは「すべて」のまま
   * （呼び出し側はこの後 syncUrl() を呼ばないので、他のパラメータには影響しない）。
   */
  function selectButton(groupEl: HTMLElement | null, value: string) {
    if (!groupEl) return;
    const buttons = groupEl.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const needle = value.toLowerCase();
    const target = Array.from(buttons).find((b) => b.dataset.value?.toLowerCase() === needle);
    if (!target) return;
    buttons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
    target.setAttribute('aria-pressed', 'true');
  }

  // 「今営業中」の定期再評価タイマー。ClientRouterでの遷移後もモジュールは
  // 再評価されないため、astro:page-load のたびにここで古いタイマーをclearしてから
  // 張り直す（多重登録防止）。
  let intervalId: ReturnType<typeof setInterval> | undefined;

  // pushState を束ねるデバウンス。連続してフィルタを操作しても、操作が
  // 止まってから一定時間後の最終状態だけを1件の履歴として積む
  // （毎クリックごとに履歴が積まれるのを防ぐ）。
  const PUSH_DEBOUNCE_MS = 300;
  let pushDebounceId: ReturnType<typeof setTimeout> | undefined;

  // window（document）はClientRouterのページ遷移をまたいで生き続けるため、
  // popstateリスナーは他のDOM要素バインドと違い「古い方は自然に消える」が
  // 成り立たない。intervalIdと同じ「古い登録を覚えておいて外してから
  // 張り直す」方式で多重登録を防ぐ。
  let popStateHandler: ((event: PopStateEvent) => void) | undefined;

  function init() {
    // 遷移のたびにDOMが差し替わるため、要素は毎回このスコープで取り直す。
    const groups = document.querySelectorAll<HTMLElement>('[data-filter-group]');
    const openToggle = document.querySelector<HTMLButtonElement>('[data-open-toggle]');
    const videoToggle = document.querySelector<HTMLButtonElement>('[data-video-toggle]');
    const cards = document.querySelectorAll<HTMLElement>('[data-spot-card]');
    const resultCount = document.querySelector<HTMLElement>('[data-result-count]');
    const emptyMessage = document.querySelector<HTMLElement>('[data-empty-message]');

    // このページに一覧/フィルタが無い（＝/spots/ 以外に遷移した）場合は何もしない。
    if (groups.length === 0) return;

    function isOpenToggleActive(): boolean {
      return openToggle?.getAttribute('aria-pressed') === 'true';
    }

    function isVideoToggleActive(): boolean {
      return videoToggle?.getAttribute('aria-pressed') === 'true';
    }

    function applyFilters() {
      const genreKey = activeKey(group('genre'));
      const sceneMatch = activeMatch(group('scene'));
      const budgetKey = activeKey(group('budget'));
      const seatMatch = activeMatch(group('seat'));
      const openActive = isOpenToggleActive();
      const videoActive = isVideoToggleActive();

      let visible = 0;
      cards.forEach((card) => {
        const genre = card.dataset.genre ?? '';
        const vibes = (card.dataset.vibes ?? '').split('|');
        const budgetMinAttr = card.dataset.budgetMin;
        const cardBudgetMin = budgetMinAttr ? Number(budgetMinAttr) : undefined;

        const genreOk = genreKey === 'all' || genre === genreKey;
        const sceneOk = sceneMatch === 'all' || vibes.includes(sceneMatch);
        const seatOk = seatMatch === 'all' || vibes.includes(seatMatch);
        const budgetOk = matchesBudget(cardBudgetMin, budgetKey);
        const videoOk = !videoActive || card.dataset.hasVideo === '1';

        let openOk = true;
        if (openActive) {
          const result = getOpenStatus(parseHours(card.dataset.hours));
          openOk = result.state === 'open' || result.state === 'closing-soon';
        }

        const show = genreOk && sceneOk && seatOk && budgetOk && openOk && videoOk;
        card.classList.toggle('hidden', !show);
        if (show) visible += 1;
      });

      if (resultCount) resultCount.textContent = `${visible}件`;
      if (emptyMessage) emptyMessage.classList.toggle('hidden', visible !== 0);
    }

    // URLクエリに書き戻すときの正規化。大文字小文字違いの同一条件URLが複数
    // 出回らないよう、常に小文字に統一する（genreの"BAR"→"bar"等。
    // scene/budget/seatはもともと小文字keyなので実質no-op）。
    // フィルタ処理自体（applyFilters）はこの関数を経由しない
    // data-value の生の値（例: "BAR"）で比較するので、ここで小文字化しても
    // 絞り込みロジックには influence しない。
    function normalizeForUrl(value: string): string {
      return value.toLowerCase();
    }

    /** 現在のボタン状態から、書き戻すべきURL文字列（path+search+hash）を組み立てる。 */
    function buildTargetUrl(): string {
      const params: [string, string][] = [];
      const genreKey = activeKey(group('genre'));
      const sceneKey = activeKey(group('scene'));
      const budgetKey = activeKey(group('budget'));
      const seatKey = activeKey(group('seat'));

      if (genreKey !== 'all') params.push(['genre', normalizeForUrl(genreKey)]);
      if (sceneKey !== 'all') params.push(['scene', normalizeForUrl(sceneKey)]);
      if (budgetKey !== 'all') params.push(['budget', normalizeForUrl(budgetKey)]);
      if (seatKey !== 'all') params.push(['seat', normalizeForUrl(seatKey)]);
      if (isOpenToggleActive()) params.push(['open', 'now']);
      if (isVideoToggleActive()) params.push(['video', 'yes']);

      const url = new URL(location.href);
      url.search = '';
      for (const [key, value] of params) url.searchParams.set(key, value);
      return url.pathname + url.search + url.hash;
    }

    function currentUrl(): string {
      return location.pathname + location.search + location.hash;
    }

    // ページ初回表示時のURL復元（restoreFromUrl直後）専用。履歴には積まず、
    // 表記ゆれ（大文字小文字・パラメータ順）だけを正規化する。これは
    // 従来の挙動を維持するための呼び出しで、以後の操作ではこちらは使わない。
    function replaceUrl() {
      history.replaceState(null, '', buildTargetUrl());
    }

    // フィルタ操作によるURL更新はpushStateで履歴に積むが、直接は呼ばず
    // 必ずこのデバウンス経由にする。
    // - 連続操作をまとめる: 呼ばれるたびに前回のタイマーを破棄して張り直す
    //   ため、操作が止まってからPUSH_DEBOUNCE_MS後の最終状態だけが積まれる
    // - 重複防止: タイマー発火時点で、目的のURLが現在のURLと同じなら
    //   （＝結果的に状態が変わらなかった、または直前のpushと同じ状態に
    //   戻ってきた）pushしない
    // - 復元中（popstateによる巻き戻し・ページ初回表示）はisRestoringFromUrl
    //   により呼び出し自体を無視する
    function scheduleUrlPush() {
      if (isRestoringFromUrl) return;
      if (pushDebounceId !== undefined) clearTimeout(pushDebounceId);
      pushDebounceId = setTimeout(() => {
        pushDebounceId = undefined;
        const target = buildTargetUrl();
        if (target === currentUrl()) return;
        history.pushState(null, '', target);
      }, PUSH_DEBOUNCE_MS);
    }

    // popstate（戻る/進む）による復元中は、restoreFromUrlが呼ぶselectButtonは
    // setAttributeの直接操作なのでclickイベントは発火せずscheduleUrlPushには
    // 波及しない（既存の初期表示と同じ理屈）。ただしこのフラグは、将来
    // restoreFromUrl周りにclickベースの操作が混ざっても安全なように、
    // 復元処理中はURL書き込み系（scheduleUrlPush/replaceUrl）を明示的に
    // 抑止するための保険として持たせておく。
    let isRestoringFromUrl = false;

    // 各グループを「URLに値があればそれを選択、無ければ"all"に戻す」で
    // 常に完全同期する（値がある場合だけ設定して無ければ何もしない、という
    // 片方向の実装だと、popstateでの復元時に「一度絞り込んだ後、その条件が
    // URLから消えたのにボタン表示だけ絞り込んだままになる」問題が起きる。
    // 初回表示時はどのグループも最初から"all"なので、この完全同期でも
    // 従来と見た目は変わらない）。
    function restoreFromUrl() {
      isRestoringFromUrl = true;
      try {
        const params = new URL(location.href).searchParams;

        selectButton(group('genre'), params.get('genre') ?? 'all');
        selectButton(group('scene'), params.get('scene') ?? 'all');
        selectButton(group('budget'), params.get('budget') ?? 'all');
        selectButton(group('seat'), params.get('seat') ?? 'all');

        // openは選択肢が"now"の1つだけだが、他4項目と同様に大文字小文字を区別しない。
        openToggle?.setAttribute('aria-pressed', String(params.get('open')?.toLowerCase() === 'now'));

        // videoも同様、選択肢は"yes"の1つだけ。
        videoToggle?.setAttribute('aria-pressed', String(params.get('video')?.toLowerCase() === 'yes'));
      } finally {
        isRestoringFromUrl = false;
      }
    }

    // 初期表示: URLクエリを読んでボタン状態を復元し、フィルタを適用したうえで
    // URLを正規化された表記に書き戻す（pushStateはしない。ここは従来通り）。
    // selectButton・openToggleの操作はsetAttributeによる直接操作でクリック
    // イベントを発火させないため、ここで一度だけ実行すれば十分（多重発火や
    // 無限ループの心配は無い）。一致しなかったパラメータはそのグループが
    // 「すべて」のまま処理されるだけで、他のパラメータの復元・書き戻しには
    // 影響しない（buildTargetUrlは各グループを独立に読むため）。
    restoreFromUrl();
    applyFilters();
    replaceUrl();

    groups.forEach((groupEl) => {
      const buttons = groupEl.querySelectorAll<HTMLButtonElement>('.filter-btn');
      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          buttons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
          button.setAttribute('aria-pressed', 'true');
          applyFilters();
          scheduleUrlPush();
        });
      });
    });

    openToggle?.addEventListener('click', () => {
      const active = isOpenToggleActive();
      openToggle.setAttribute('aria-pressed', String(!active));
      applyFilters();
      scheduleUrlPush();
    });

    videoToggle?.addEventListener('click', () => {
      const active = isVideoToggleActive();
      videoToggle.setAttribute('aria-pressed', String(!active));
      applyFilters();
      scheduleUrlPush();
    });

    // 「今営業中」有効時は、閲覧中に営業状態が変わりうるので定期的に再評価する。
    if (intervalId !== undefined) clearInterval(intervalId);
    intervalId = setInterval(() => {
      if (isOpenToggleActive()) applyFilters();
    }, 60_000);

    // 戻る/進むでの履歴移動に追従する。ClientRouter環境下ではastro:page-load
    // だけでは同一ページ内（/spots/内でのフィルタ履歴間）の移動を拾えない
    // ため、popstateでも明示的にrestoreFromUrl+applyFiltersを行う。
    // ここではpushState/replaceStateを一切呼ばない
    // （ブラウザが実際に移動した先のURLをそのまま信頼して表示を合わせる
    // だけであり、URL側を書き戻す必要がない。呼んでしまうと不要な履歴が
    // 積まれたり、pushStateが新しい履歴を作って「進む」を潰したりする）。
    if (popStateHandler) window.removeEventListener('popstate', popStateHandler);
    popStateHandler = () => {
      restoreFromUrl();
      applyFilters();
    };
    window.addEventListener('popstate', popStateHandler);
  }

  // astro:page-load は初回読み込み時にも発火するため、初期化はここだけに一本化する。
  document.addEventListener('astro:page-load', init);
</script>
