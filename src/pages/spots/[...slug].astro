---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Prose from '../../components/Prose.astro';
import Badge from '../../components/Badge.astro';
import GenreIcon from '../../components/GenreIcon.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import OpenStatus from '../../components/OpenStatus.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import StructuredData from '../../components/StructuredData.astro';
import SocialIcon from '../../components/SocialIcon.astro';
import ShareButton from '../../components/ShareButton.astro';
import { getCollection, render } from 'astro:content';
import { ExternalLink, Map as MapIcon } from '@lucide/astro';
import { getSpotSchemaType } from '../../lib/spotSchemaType';
import { buildGoogleMapsUrl, buildOpeningHoursSpecification, buildSpotAddress } from '../../lib/structuredData';
import { resolveOgpImage } from '../../lib/ogpImagePath';

export async function getStaticPaths() {
  const spots = await getCollection('spots');
  return spots.map((spot) => ({
    params: { slug: spot.id },
    props: { spot },
  }));
}

const { spot } = Astro.props;
const {
  title,
  genre,
  address,
  budget,
  openHours,
  regularHoliday,
  vibes,
  isNew,
  hours,
  isIrregular,
  description,
  mapQuery,
  pubDate,
  youtubeVideos,
  socialLinks,
} = spot.data;
const { Content } = await render(spot);
const publishedDateLabel = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'Asia/Tokyo',
}).format(pubDate);

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
// scripts/generate-ogp-images.tsが生成した店舗ごとのOGP画像。生成に
// 失敗している場合はundefinedになり、ogImageプロパティ自体を渡さないことで
// Layout.astro側のデフォルト（ogp-default.png）に自然にフォールバックする。
const ogImagePath = resolveOgpImage('spot', spot.id);
const absoluteImage = new URL(ogImagePath ?? '/images/ogp-default.png', Astro.site ?? Astro.url).toString();

// 不定休の店（isIrregular）は、hoursに「便宜上の毎日営業」として登録
// されていることがある（実際に何曜日が休みか特定できないため）。この状態
// のままGoogleにopeningHoursSpecificationとして渡すと、本来休んでいる日を
// 「営業中」と検索結果に表示させてしまう恐れがあるため、isIrregularが
// trueの店ではopeningHoursSpecification自体を出力しない。
// （以前はregularHolidayの文字列に"不定休"を含むかで判定していたが、
// 明示的なisIrregularフラグの方が確実なため切り替えた）
const openingHoursSpecification = isIrregular ? undefined : buildOpeningHoursSpecification(hours);

const structuredData: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': getSpotSchemaType(genre),
  name: title,
  description,
  url: canonicalUrl,
  address: buildSpotAddress(address),
  servesCuisine: genre,
  priceRange: budget,
  hasMap: buildGoogleMapsUrl(mapQuery),
  image: absoluteImage,
  ...(socialLinks?.length ? { sameAs: socialLinks.map((link) => link.url) } : {}),
  ...(openingHoursSpecification ? { openingHoursSpecification } : {}),
};

const socialPlatformLabels = {
  instagram: 'Instagram',
  facebook: 'Facebook',
  x: 'X',
  line: 'LINE',
} as const;
---

<Layout
  title={`${title}｜本寺小路ガイド`}
  description={description}
  ogType="article"
  ogImage={ogImagePath}
  publishedTime={pubDate}
>
  <StructuredData data={structuredData} />
  <Header showBackLink backHref="/spots/" backLabel="店舗一覧に戻る" />

  <main class="mx-auto max-w-3xl px-4 py-8">
    <article>
      <div class="flex items-center gap-3">
        <span
          class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-amber-deep/50 bg-amber-glow/10 text-amber-glow"
        >
          <GenreIcon genre={genre} size={22} />
        </span>
        <div class="flex flex-wrap items-center gap-2 text-xs">
          <span class="font-medium tracking-wide text-amber-glow">{genre}</span>
          {
            isNew && (
              <span class="inline-flex items-center gap-1 rounded-full bg-vermilion px-2.5 py-1 text-[0.65rem] font-bold tracking-wide text-white">
                <span class="lantern-breathe h-1.5 w-1.5 rounded-full bg-white" />
                NEW
              </span>
            )
          }
        </div>
      </div>

      <h1 class="mt-3 font-serif text-3xl font-bold text-gold-100 text-glow sm:text-4xl">
        {title}
      </h1>

      <p class="mt-4 leading-relaxed text-gold-100/70">{description}</p>

      <div class="mt-5 flex flex-wrap gap-2">
        {vibes.map((vibe) => <Badge label={vibe} variant="solid" />)}
      </div>

      <ShareButton title={title} url={canonicalUrl} class="mt-5" />

      <dl class="mt-8 grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-night-700 bg-night-700 sm:grid-cols-2">
        <div class="bg-night-900 px-4 py-3 sm:col-span-2">
          <dt class="text-xs text-gold-100/40">住所</dt>
          <dd class="mt-1 text-sm text-gold-100/85">{address}</dd>
        </div>
        <div class="bg-night-900 px-4 py-3">
          <div class="flex items-center justify-between gap-2">
            <dt class="text-xs text-gold-100/40">営業時間</dt>
            <OpenStatus hours={hours} isIrregular={isIrregular} size="sm" />
          </div>
          <dd class="mt-1 text-sm text-gold-100/85">{openHours}</dd>
        </div>
        <div class="bg-night-900 px-4 py-3">
          <dt class="text-xs text-gold-100/40">定休日</dt>
          <dd class="mt-1 text-sm text-gold-100/85">{regularHoliday}</dd>
        </div>
        <div class="bg-night-900 px-4 py-3 sm:col-span-2">
          <dt class="text-xs text-gold-100/40">予算目安</dt>
          <dd class="mt-1 text-sm text-gold-100/85">{budget}</dd>
        </div>
      </dl>

      <div class="mt-3 flex flex-col gap-1 text-xs leading-relaxed text-gold-100/40 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
        <p>営業時間・定休日・予算などは変更される場合があります。来店前に店舗の公式情報をご確認ください。</p>
        <p class="shrink-0">
          掲載日：<time datetime={pubDate.toISOString().slice(0, 10)}>{publishedDateLabel}</time>
        </p>
      </div>

      {
        socialLinks && socialLinks.length > 0 && (
          <section class="mt-6" aria-labelledby="spot-social-heading">
            <h2 id="spot-social-heading" class="text-xs font-medium tracking-wide text-gold-100/40">
              公式SNS
            </h2>
            <div class="mt-2 flex flex-wrap gap-2">
              {socialLinks.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-night-600 bg-night-900 text-gold-100/70 transition hover:border-amber-deep/70 hover:text-amber-glow"
                  aria-label={`${title}の公式${socialPlatformLabels[link.platform]}を開く（外部サイト）`}
                  title={link.label ?? socialPlatformLabels[link.platform]}
                >
                  <SocialIcon platform={link.platform} size={18} />
                </a>
              ))}
            </div>
          </section>
        )
      }

      <Prose class="mt-10">
        <Content />
      </Prose>

      {
        youtubeVideos && youtubeVideos.length > 0 && (
          <section class="mt-10">
            <h2 class="font-serif text-xl font-bold text-gold-100">燕三条TVで紹介されました</h2>
            <div class="mt-4 space-y-6">
              {youtubeVideos.map((video) => (
                <div>
                  {video.label && (
                    <p class="mb-2 text-xs font-medium tracking-wide text-amber-glow">{video.label}</p>
                  )}
                  <YouTubeEmbed videoId={video.id} storeName={title} label={video.label} />
                </div>
              ))}
            </div>
            <p class="mt-4 text-xs text-gold-100/50">
              <a
                href="https://www.youtube.com/@TsubameSanjoTV"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-amber-glow transition hover:text-amber-glow/80"
              >
                燕三条TVのチャンネルを見る
                <ExternalLink size={12} aria-hidden="true" />
              </a>
            </p>
          </section>
        )
      }

      <MapEmbed title={title} query={mapQuery} />

      <nav class="mt-12 flex flex-col gap-3 border-t border-night-700 pt-6 sm:flex-row sm:items-center sm:justify-between" aria-label="店舗ページの次の行き先">
        <a
          href="/spots/"
          class="inline-flex min-h-11 items-center gap-1 text-sm text-gold-100/60 transition hover:text-amber-glow"
        >
          ← 本寺小路の店舗一覧に戻る
        </a>
        <a
          href="/map/"
          class="inline-flex min-h-11 items-center gap-2 text-sm font-medium text-amber-glow transition hover:underline hover:underline-offset-4"
        >
          <MapIcon size={15} stroke-width={1.8} aria-hidden="true" />
          路地マップで店を探す
        </a>
      </nav>
    </article>
  </main>

  <Footer />
</Layout>
