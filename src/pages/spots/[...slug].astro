---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Badge from '../../components/Badge.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const spots = await getCollection('spots');
  return spots.map((spot) => ({
    params: { slug: spot.id },
    props: { spot },
  }));
}

const { spot } = Astro.props;
const { title, genre, area, address, businessHours, budget, features, description } = spot.data;
const { Content } = await render(spot);
---

<Layout title={`${title}｜本寺小路ガイド`} description={description}>
  <Header showBackLink />

  <main class="mx-auto max-w-3xl px-4 py-8">
    <article>
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <span class="font-medium tracking-wide text-amber-glow">{genre}</span>
        <span class="text-gold-100/30">·</span>
        <span class="text-gold-100/50">{area}</span>
      </div>

      <h1 class="mt-3 font-serif text-3xl font-bold text-gold-100 text-glow sm:text-4xl">
        {title}
      </h1>

      <p class="mt-4 leading-relaxed text-gold-100/70">{description}</p>

      <div class="mt-5 flex flex-wrap gap-2">
        {features.map((feature) => <Badge label={feature} variant="solid" />)}
      </div>

      <dl class="mt-8 grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-night-700 bg-night-700 sm:grid-cols-2">
        <div class="bg-night-900 px-4 py-3">
          <dt class="text-xs text-gold-100/40">住所</dt>
          <dd class="mt-1 text-sm text-gold-100/85">{address}</dd>
        </div>
        <div class="bg-night-900 px-4 py-3">
          <dt class="text-xs text-gold-100/40">営業時間</dt>
          <dd class="mt-1 text-sm text-gold-100/85">{businessHours}</dd>
        </div>
        <div class="bg-night-900 px-4 py-3 sm:col-span-2">
          <dt class="text-xs text-gold-100/40">予算目安</dt>
          <dd class="mt-1 text-sm text-gold-100/85">{budget}</dd>
        </div>
      </dl>

      <div
        class="prose prose-invert prose-headings:font-serif prose-headings:text-gold-100 prose-p:text-gold-100/70 prose-li:text-gold-100/70 prose-strong:text-amber-glow mt-10 max-w-none prose-headings:mt-8 prose-headings:mb-3 prose-h2:text-xl prose-h2:border-b prose-h2:border-night-700 prose-h2:pb-2"
      >
        <Content />
      </div>

      <div class="mt-12 border-t border-night-700 pt-6">
        <a
          href="/"
          class="inline-flex items-center gap-1 text-sm text-gold-100/60 transition hover:text-amber-glow"
        >
          ← 本寺小路の店舗一覧に戻る
        </a>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
