---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import EmptyState from '../../components/EmptyState.astro';
import NewsListItem from '../../components/NewsListItem.astro';
import { getCollection } from 'astro:content';
import { Megaphone } from '@lucide/astro';

const news = (await getCollection('news')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="ニュース一覧｜本寺小路ガイド"
  description="本寺小路ガイドのお知らせ・新店舗情報・イベント情報を新着順にまとめています。"
>
  <Header />

  <main class="mx-auto max-w-5xl px-4 py-10">
    <SectionHeading icon={Megaphone} label="NEWS" accent="vermilion" level="h1">ニュース一覧</SectionHeading>

    {
      news.length > 0 ? (
        <ul class="mt-6 divide-y divide-night-700">
          {news.map((item) => <NewsListItem item={item} />)}
        </ul>
      ) : (
        <EmptyState message="現在お知らせはありません。" class="mt-6" />
      )
    }
  </main>

  <Footer />
</Layout>
