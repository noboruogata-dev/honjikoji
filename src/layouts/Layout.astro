---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import OmikujiButton from '../components/OmikujiButton.astro';
import AlleyNight from '../components/illustrations/AlleyNight.astro';

interface Props {
  title: string;
  description?: string;
  /** OGPの type。記事系ページ（店舗詳細・ニュース詳細・歴史コラム）は "article"、それ以外は "website"。 */
  ogType?: 'website' | 'article';
  /** サイトルート相対パス、または絶対URL。省略時はブランドのOGPデフォルト画像。 */
  ogImage?: string;
  /** ogType="article" のときのみ使用（記事の公開日時）。 */
  publishedTime?: Date;
  /** 検索結果に出したくない準備中ページ等で true にする（例: /columns/）。 */
  noindex?: boolean;
}

const SITE_NAME = '本寺小路ガイド | 三条の、夜のはじまり。';
const DEFAULT_DESCRIPTION =
  '新潟県三条市の歓楽街「本寺小路」の飲食店・店舗ガイド。居酒屋、焼肉、ラーメン、BAR、スナックなど、夜の一軒を見つけよう。';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  ogType = 'website',
  ogImage = '/images/ogp-default.png',
  publishedTime,
  noindex = false,
} = Astro.props;

// Astro.site（astro.config.mjs の site）を基準に絶対URLを組み立てる。
// site が未設定の場合はビルド/プレビュー時点の Astro.url をフォールバックにする。
const siteOrigin = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const absoluteOgImage = new URL(ogImage, siteOrigin).toString();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!--
      時間帯テーマの同期（FOUC防止のため is:inline で同期実行し、CSSより前に
      documentElement へ data-time をセットする）。Asia/Tokyo固定で判定する。
      ClientRouterでのページ遷移後も data-time が引き継がれるよう、
      astro:page-load でも同じ関数を呼ぶ（is:inline自体もswap時に再実行されるが、
      二重登録を避けるため window フラグで1回だけ addEventListener する）。
    -->
    <script is:inline>
      (function () {
        function computeTimeBucket() {
          try {
            var parts = new Intl.DateTimeFormat('en-US', {
              timeZone: 'Asia/Tokyo',
              hour: '2-digit',
              hour12: false,
            }).formatToParts(new Date());
            var hourPart = parts.find(function (p) {
              return p.type === 'hour';
            });
            var hour = hourPart ? parseInt(hourPart.value, 10) : NaN;
            if (hour === 24) hour = 0;
            if (!isFinite(hour)) return 'night';
            if (hour >= 23 || hour < 5) return 'latenight';
            if (hour >= 16 && hour < 19) return 'dusk';
            return 'night';
          } catch (e) {
            return 'night';
          }
        }

        function syncTime() {
          document.documentElement.dataset.time = computeTimeBucket();
        }

        syncTime();

        if (!window.__timeSyncBound) {
          window.__timeSyncBound = true;
          document.addEventListener('astro:page-load', syncTime);
        }
      })();
    </script>

    <!--
      フッター等、常時DOM上に残る要素（transition:persist）や固定要素の中の
      リンクからClientRouterで別ページへ遷移すると、ブラウザによっては遷移前の
      スクロール位置がそのまま残ってしまうことがある（モバイルメニュー
      （[data-mobile-menu]、Header.astro）で最初に見つかった不具合と同種で、
      フッターでも発生することが分かった）。ページ遷移を伴うリンククリックを
      検知しておき、遷移完了後（astro:page-load）に必ず先頭へスクロールし
      直すことで、どこからのリンクでも確実にページ先頭に戻れるようにする。
      通常のscript（is:inlineではない）のため、このモジュール自体は初回の
      1回しか評価されない（ClientRouterでの遷移はモジュールを再実行しない）
      = window フラグでの二重登録防止は不要。

      低速回線下では、この直後の1回のリセットだけでは不十分なことが分かって
      いる（global.cssでhtml { overflow-anchor: none } により大半のケースは
      解消したが、それでもWebフォントの読み込み確定など遷移直後の遅れた
      再レイアウトが、リセット後にもう一度スクロール位置をずらすことが
      本番環境で確認された）。原因（何が・いつずらすか）を個別に潰すのではなく、
      直後・次フレーム・120ms後・400ms後の複数タイミングで同じリセットを
      再度当てることで、どのタイミングで再レイアウトが起きても確実に先頭へ
      戻るようにする。ページ自体は既に先頭にあるため、ずれが実際に起きて
      いない大多数のケースでは追加のscrollTo呼び出しは無害（見た目上の
      ちらつき無し）。
    -->
    <script>
      let pendingScrollReset = false;

      function isPlainLeftClick(event: MouseEvent): boolean {
        return event.button === 0 && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey;
      }

      document.addEventListener(
        'click',
        (event) => {
          if (!isPlainLeftClick(event)) return;
          const target = event.target;
          if (!(target instanceof Element)) return;
          const link = target.closest('a[href]');
          if (!link || link.target === '_blank') return;
          let url: URL;
          try {
            url = new URL(link.href, location.href);
          } catch {
            return;
          }
          if (url.origin !== location.origin) return;
          // パス・クエリが変わらない（ページ内ハッシュ移動等）は対象外。
          if (url.pathname === location.pathname && url.search === location.search) return;
          pendingScrollReset = true;
        },
        true
      );

      document.addEventListener('astro:page-load', () => {
        if (!pendingScrollReset) return;
        pendingScrollReset = false;
        const resetToTop = () => window.scrollTo({ top: 0, left: 0 });
        resetToTop();
        requestAnimationFrame(resetToTop);
        setTimeout(resetToTop, 120);
        setTimeout(resetToTop, 400);
      });
    </script>

    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ja_JP" />
    {
      ogType === 'article' && publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;700&family=Noto+Sans+JP:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />
  </head>
  <body class="min-h-screen antialiased">
    <!--
      ページ全体を貫く路地の背景。以前はページごとに個別のHero/特集ボックスが
      自分の中だけにAlleyNightを閉じ込めて持っていたため、サイト全体が
      「箱を積み重ねたダッシュボード」に見えていた（トップページで先行して
      解消済み。ここに置くことで全ページへ広げる）。position: fixedで
      ビューポート下端に据え、スクロールしても常に路地の中に立っている
      感覚を保つ。z-indexは使わない（DOM順で最初に置くだけで、
      Header(z-50)・後続の通常コンテンツより自然に背面へ回る。負の
      z-indexはbodyの背景に隠れてしまう場合があるため避ける）。 -->
    <div class="pointer-events-none fixed inset-x-0 bottom-0 h-[65vh] overflow-hidden sm:h-[55vh]" aria-hidden="true">
      <AlleyNight ignite="load" class="absolute inset-x-0 bottom-0 h-full w-full opacity-[0.14]" />
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_90%_60%_at_50%_100%,var(--glow),transparent)]"></div>
    </div>

    <slot />
    <OmikujiButton />
  </body>
</html>
