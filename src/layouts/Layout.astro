---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import OmikujiButton from '../components/OmikujiButton.astro';

interface Props {
  title: string;
  description?: string;
  /** OGPの type。記事系ページ（店舗詳細・ニュース詳細・歴史コラム）は "article"、それ以外は "website"。 */
  ogType?: 'website' | 'article';
  /** サイトルート相対パス、または絶対URL。省略時はブランドのOGPデフォルト画像。 */
  ogImage?: string;
  /** ogType="article" のときのみ使用（記事の公開日時）。 */
  publishedTime?: Date;
  /** 検索結果に出したくない準備中ページ等で true にする（例: /columns/）。 */
  noindex?: boolean;
}

const SITE_NAME = '本寺小路ガイド | 三条の、夜のはじまり。';
const DEFAULT_DESCRIPTION =
  '新潟県三条市の歓楽街「本寺小路」の飲食店・店舗ガイド。居酒屋、焼肉、ラーメン、BAR、スナックなど、夜の一軒を見つけよう。';

const {
  title,
  description = DEFAULT_DESCRIPTION,
  ogType = 'website',
  ogImage = '/images/ogp-default.png',
  publishedTime,
  noindex = false,
} = Astro.props;

// Astro.site（astro.config.mjs の site）を基準に絶対URLを組み立てる。
// site が未設定の場合はビルド/プレビュー時点の Astro.url をフォールバックにする。
const siteOrigin = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const absoluteOgImage = new URL(ogImage, siteOrigin).toString();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!--
      時間帯テーマの同期（FOUC防止のため is:inline で同期実行し、CSSより前に
      documentElement へ data-time をセットする）。Asia/Tokyo固定で判定する。
      ClientRouterでのページ遷移後も data-time が引き継がれるよう、
      astro:page-load でも同じ関数を呼ぶ（is:inline自体もswap時に再実行されるが、
      二重登録を避けるため window フラグで1回だけ addEventListener する）。
    -->
    <script is:inline>
      (function () {
        function computeTimeBucket() {
          try {
            var parts = new Intl.DateTimeFormat('en-US', {
              timeZone: 'Asia/Tokyo',
              hour: '2-digit',
              hour12: false,
            }).formatToParts(new Date());
            var hourPart = parts.find(function (p) {
              return p.type === 'hour';
            });
            var hour = hourPart ? parseInt(hourPart.value, 10) : NaN;
            if (hour === 24) hour = 0;
            if (!isFinite(hour)) return 'night';
            if (hour >= 23 || hour < 5) return 'latenight';
            if (hour >= 16 && hour < 19) return 'dusk';
            return 'night';
          } catch (e) {
            return 'night';
          }
        }

        function syncTime() {
          document.documentElement.dataset.time = computeTimeBucket();
        }

        syncTime();

        if (!window.__timeSyncBound) {
          window.__timeSyncBound = true;
          document.addEventListener('astro:page-load', syncTime);
        }
      })();
    </script>

    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ja_JP" />
    {
      ogType === 'article' && publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;700&family=Noto+Sans+JP:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />
  </head>
  <body class="min-h-screen antialiased">
    <slot />
    <OmikujiButton />
  </body>
</html>
