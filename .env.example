# Gemini API キー（https://aistudio.google.com/apikey で取得）
# scripts/generate-spot.ts が読み込みます。
GEMINI_API_KEY=

# コラム挿絵生成モデル。未指定時は公式画像生成モデルの既定値を使用します。
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# YouTube Data API v3 のAPIキー（Google Cloud ConsoleでYouTube Data API v3を
# 有効化のうえ発行してください）。scripts/match-youtube.ts が読み込みます。
YOUTUBE_API_KEY=

# Google Places API (New) のAPIキー（任意。Places API (New) を有効化のうえ、
# 「APIの制限」でPlaces API (New) のみに絞って発行してください）。
# scripts/generate-spot.ts が Text Search（店名・住所からのPlace ID解決）に
# 使います。未設定でも従来通り動作します（placeIdが付かないだけで、
# 詳細ページはopenHours/regularHoliday表示にフォールバックします）。
# 詳細ページのライブ営業時間表示（Place Details呼び出し）は、これとは別に
# Cloudflare Pages側の環境変数 GOOGLE_PLACES_API_KEY（別キー推奨）を使います
# （functions/api/place-hours.ts）。
GOOGLE_PLACES_API_KEY=
